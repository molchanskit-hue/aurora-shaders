index 0000000..16a92cf
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/native_entity.rs
@@ -0,0 +1,263 @@
+//! Local lighting.2 model hook. Vanilla alpha, overlays, glint and fog remain
+//! engine-owned. No changes to entity vertex buffers or the stock pipelines.
+use horizon_shader_api::check::CheckedStage;
+
+use super::native_post::{NativeFrame, present_constants};
+use super::native_shadow::NativeShadow;
+
+pub struct NativeEntity {
+    pub world: wgpu::RenderPipeline,
+    pub hand: wgpu::RenderPipeline,
+}
+
+#[cfg(test)]
+#[path = "native_entity_gpu.rs"]
+mod gpu_tests;
+
+/// Same entity resources for vanilla, the opt-in hook, and GPU validation.
+pub fn bindings(device: &wgpu::Device) -> wgpu::BindGroupLayout {
+    let entries: Vec<_> = (0..8)
+        .map(|binding| wgpu::BindGroupLayoutEntry {
+            binding,
+            visibility: wgpu::ShaderStages::VERTEX_FRAGMENT,
+            count: None,
+            ty: match binding {
+                0 => wgpu::BindingType::Buffer {
+                    ty: wgpu::BufferBindingType::Uniform,
+                    has_dynamic_offset: false,
+                    min_binding_size: None,
+                },
+                2 | 4 | 6 => wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                _ => wgpu::BindingType::Texture {
+                    sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                    view_dimension: wgpu::TextureViewDimension::D2,
+                    multisampled: false,
+                },
+            },
+        })
+        .collect();
+    device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: Some("Entity bindings"),
+        entries: &entries,
+    })
+}
+
+pub(super) fn shader_source(stage: &CheckedStage) -> String {
+    let mut engine = super::entity_shader();
+    // wgpu reserves one of the default 16 fragment-input variables for
+    // front_facing. Pack the two fog distances into one varying so the
+    // user interface has only 15 variables (locations 0..14).
+    engine = engine
+        .replace(
+            "@location(2) spherical: f32,\n    @location(3) cylindrical: f32,",
+            "@location(2) fog_distances: vec2<f32>,",
+        )
+        .replace("out.spherical", "out.fog_distances.x")
+        .replace("out.cylindrical", "out.fog_distances.y")
+        .replace("in.spherical", "in.fog_distances.x")
+        .replace("in.cylindrical", "in.fog_distances.y");
+    // The raw tint's alpha carries
+    // sky+1 for eligible models, -1 for baked/unlit/effect quads. Original
+    // alpha is still in color.a; position_light.w carries block light.
+    engine = engine.replace("struct Out {", "override NATIVE_HAND: bool = false;\nstruct Out {\n    @location(3) raw_tint: vec4<f32>,\n    @location(14) position_light: vec4<f32>,");
+    engine = engine.replace(
+        "    out.light_color = select(lm, vec4(1.0), unlit);",
+        "
+    out.light_color = select(lm, vec4(1.0), unlit);
+    let model = abs(normal.w) >= 0.5 && !unlit
+        && (overlay == 0u || overlay == 1u || overlay == 5u || overlay == 7u
+            || overlay == 8u || (overlay >= 16u && overlay < 32u) || overlay == 36u);
+    // Explicit fullbright levels also protect emissive model layers that
+    // still carry a normal (e.g. the warden). Baked items keep vanilla.
+    let eligible = model && !(light.x >= 240u && light.y >= 240u);
+    out.raw_tint = vec4(color.rgb, select(-1.0, 1.0 + clamp(l.y / 240.0, 0.0, 1.0), eligible));
+    out.position_light = vec4(position, clamp(l.x / 240.0, 0.0, 1.0));
+",
+    );
+    engine = engine.replace("    var uv = in.uv;", "    let position_dx = dpdx(in.position_light.xyz);\n    let position_dy = dpdy(in.position_light.xyz);\n    var uv = in.uv;");
+    engine = engine.replace("    var color = textureSample(atlas, atlas_sampler, uv) * select(in.back_color, in.color, front);", "    let texel = textureSample(atlas, atlas_sampler, uv);\n    var color = texel * select(in.back_color, in.color, front);");
+    // Exactly this occurrence in fs_entity, before glint. Shadow blobs and
+    // other native entry points remain unchanged and are not used here.
+    engine = engine.replacen("    color *= in.light_color;\n    if in.overlay == 7u", "
+    color *= in.light_color;
+    if in.raw_tint.w >= 1.0 {
+        let albedo = vec4(mix(in.overlay_color.rgb, texel.rgb * in.raw_tint.rgb, in.overlay_color.a), color.a);
+        let custom = entity(EntityInput(albedo, color, in.position_light.xyz,
+            position_dx, position_dy, vec2(in.position_light.w, in.raw_tint.w - 1.0), NATIVE_HAND));
+        color = vec4(custom.rgb, color.a);
+    }
+    if in.overlay == 7u", 1);
+    format!(
+        "{}\n{}",
+        stage.source,
+        super::wgsl_prefix::prefixed(&engine, "horizon_entity_")
+    )
+}
+
+impl NativeEntity {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        device: &wgpu::Device,
+        entities: &wgpu::BindGroupLayout,
+        frame: &NativeFrame,
+        shadow: Option<&NativeShadow>,
+        stage: &CheckedStage,
+        constants: &[(String, f64)],
+        format: wgpu::TextureFormat,
+    ) -> Result<Self, String> {
+        let text = shader_source(stage);
+        let parsed = naga::front::wgsl::parse_str(&text)
+            .map_err(|e| format!("{}: {}", stage.file, e.emit_to_string(&text)))?;
+        let constants = present_constants(&parsed, constants);
+        let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);
+        let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some(&stage.label),
+            source: wgpu::ShaderSource::Naga(std::borrow::Cow::Owned(parsed)),
+        });
+        let layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("Native entity hook"),
+            bind_group_layouts: &[
+                Some(entities),
+                None,
+                shadow.map(|s| &s.layout),
+                Some(&frame.layout),
+            ],
+            ..Default::default()
+        });
+        let attributes = wgpu::vertex_attr_array![0=>Float32x3,1=>Float32x2,2=>Uint32,3=>Unorm8x4,4=>Uint8x4,5=>Snorm8x4,6=>Float32x2];
+        let pipeline = |hand: bool| {
+            let mut values = constants.clone();
+            values.push(("horizon_entity_NATIVE_HAND", f64::from(hand)));
+            let options = wgpu::PipelineCompilationOptions {
+                constants: &values,
+                ..Default::default()
+            };
+            device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some(&stage.label),
+                layout: Some(&layout),
+                vertex: wgpu::VertexState {
+                    module: &module,
+                    entry_point: Some("horizon_entity_vs_entity"),
+                    compilation_options: options.clone(),
+                    buffers: &[Some(wgpu::VertexBufferLayout {
+                        array_stride: std::mem::size_of::<super::Vertex>() as u64,
+                        step_mode: wgpu::VertexStepMode::Vertex,
+                        attributes: &attributes,
+                    })],
+                },
+                primitive: Default::default(),
+                depth_stencil: Some(wgpu::DepthStencilState {
+                    format: wgpu::TextureFormat::Depth32Float,
+                    depth_write_enabled: Some(true),
+                    depth_compare: Some(wgpu::CompareFunction::GreaterEqual),
+                    stencil: Default::default(),
+                    bias: Default::default(),
+                }),
+                multisample: Default::default(),
+                fragment: Some(wgpu::FragmentState {
+                    module: &module,
+                    entry_point: Some("horizon_entity_fs_entity"),
+                    compilation_options: options,
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format,
+                        blend: Some(wgpu::BlendState::ALPHA_BLENDING),
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                }),
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+        let result = Self {
+            world: pipeline(false),
+            hand: pipeline(true),
+        };
+        if let Some(e) = pollster::block_on(scope.pop()) {
+            return Err(format!("{}: {e}", stage.file));
+        }
+        Ok(result)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn entity_interstage_contract_fits_default_limits() {
+        let stage =
+            super::gpu_tests::stage("fn entity(i: EntityInput) -> vec4<f32> { return i.vanilla; }");
+        let text = shader_source(&stage);
+        let module = naga::front::wgsl::parse_str(&text).unwrap();
+        let limit = wgpu::Limits::default().max_inter_stage_shader_variables;
+        let fragment = module
+            .entry_points
+            .iter()
+            .find(|e| e.name == "horizon_entity_fs_entity")
+            .unwrap();
+        let mut variables = 0;
+        let mut builtins = 0;
+        for argument in &fragment.function.arguments {
+            let bindings: Vec<_> = match &argument.binding {
+                Some(binding) => vec![binding],
+                None => match &module.types[argument.ty].inner {
+                    naga::TypeInner::Struct { members, .. } => members
+                        .iter()
+                        .map(|m| m.binding.as_ref().unwrap())
+                        .collect(),
+                    _ => panic!("fragment input must have a binding or be an interface struct"),
+                },
+            };
+            for binding in bindings {
+                match binding {
+                    naga::Binding::Location { location, .. } => {
+                        assert!(
+                            *location < limit,
+                            "input location {location} exceeds {limit}"
+                        );
+                        variables += 1;
+                    }
+                    naga::Binding::BuiltIn(naga::BuiltIn::Position { .. }) => {}
+                    naga::Binding::BuiltIn(
+                        naga::BuiltIn::FrontFacing
+                        | naga::BuiltIn::SampleIndex
+                        | naga::BuiltIn::SampleMask,
+                    ) => builtins += 1,
+                    other => panic!("account for fragment input {other:?} in the limit check"),
+                }
+            }
+        }
+        assert!(
+            variables + builtins <= limit,
+            "{variables} user inputs + {builtins} built-in deductions exceed {limit}"
+        );
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::all(),
+        )
+        .validate(&module)
+        .unwrap_or_else(|e| panic!("{}", e.emit_to_string(&text)));
+    }
+
+    #[test]
+    #[ignore = "developer harness: HORIZON_VALIDATE_SHADER_PACK required"]
+    fn local_entity_composes_with_renderer() {
+        let path = std::env::var("HORIZON_VALIDATE_SHADER_PACK").unwrap();
+        let pack = horizon_shader_api::Pack::read(std::path::Path::new(&path)).unwrap();
+        let report = horizon_shader_api::check(&pack).unwrap();
+        let stage = report
+            .stages
+            .iter()
+            .find(|s| s.kind == horizon_shader_api::StageKind::Entity)
+            .unwrap();
+        let text = shader_source(stage);
+        let module = naga::front::wgsl::parse_str(&text)
+            .unwrap_or_else(|e| panic!("{}", e.emit_to_string(&text)));
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::all(),
+        )
+        .validate(&module)
+        .unwrap_or_else(|e| panic!("{}", e.emit_to_string(&text)));
+    }
+}
