+    [
+        (horizon_shader_api::MANIFEST,manifest.as_str()),
+        ("m.wgsl","fn material(i: MaterialInput) -> Surface { return Surface(vec4(i.lighting.rgb, i.albedo.a), false); }"),
+        ("e.wgsl","fn entity(i: EntityInput) -> vec4<f32> { return i.vanilla; }"),
+        ("p.wgsl","fn post(i: PostInput) -> vec4<f32> { return i.color; }"),
+    ].map(|(n,s)|(n.to_owned(),s.as_bytes().to_vec())).into()
+}
+
+#[test]
+fn entity_hook_is_opt_in_and_does_not_get_the_scene_snapshot() {
+    let pack = Pack::from_files(files("0.1-aurora-lighting.2")).unwrap();
+    let bytes = pack.package().unwrap();
+    assert!(!bytes.is_empty());
+    assert!(pack.manifest.files().contains(&"e.wgsl"));
+    let report = check(&pack).unwrap();
+    let stage = report
+        .stages
+        .iter()
+        .find(|s| s.kind == StageKind::Entity)
+        .unwrap();
+    assert!(stage.sun_shadow && stage.clean_lighting);
+    assert!(!stage.scene_snapshot);
+    assert!(stage.source.contains("position_dx: vec3<f32>"));
+    assert!(!stage.source.contains("pre_translucent_color"));
+    for api in ["0.1", "0.1-aurora-atmosphere.2", "0.1-aurora-lighting.1"] {
+        let error = Pack::from_files(files(api)).unwrap_err();
+        assert!(error.contains("[entity] requires"), "{error}");
+    }
+}
