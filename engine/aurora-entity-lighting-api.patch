@@ -0,0 +1,296 @@
+//! Render/readback contract: clean tint, light order, hand flag, hurt overlay,
+//! glint, alpha cutout, and bypass of baked/unlit/fullbright geometry.
+use super::*;
+use bytemuck::Zeroable;
+use wgpu::util::DeviceExt;
+
+pub(super) fn stage(body: &str) -> CheckedStage {
+    let manifest = "schema=1\nid=\"entity_probe\"\nname=\"Probe\"\nversion=\"1\"\napi=\"0.1-aurora-lighting.2\"\n[sun_shadows]\nquality=\"low\"\n[material]\nfile=\"m.wgsl\"\n[entity]\nfile=\"e.wgsl\"\n[[post]]\nfile=\"p.wgsl\"\n";
+    let files = [
+        (horizon_shader_api::MANIFEST, manifest),
+        (
+            "m.wgsl",
+            "fn material(i: MaterialInput) -> Surface { return Surface(i.albedo, false); }",
+        ),
+        ("e.wgsl", body),
+        (
+            "p.wgsl",
+            "fn post(i: PostInput) -> vec4<f32> { return i.color; }",
+        ),
+    ]
+    .map(|(n, s)| (n.to_owned(), s.as_bytes().to_vec()))
+    .into();
+    horizon_shader_api::check(&horizon_shader_api::Pack::from_files(files).unwrap())
+        .unwrap()
+        .stages
+        .into_iter()
+        .find(|s| s.kind == horizon_shader_api::StageKind::Entity)
+        .unwrap()
+}
+
+#[test]
+fn model_hook_contract_on_gpu() {
+    let instance = wgpu::Instance::new(wgpu::InstanceDescriptor::new_without_display_handle());
+    let Ok(adapter) = pollster::block_on(instance.request_adapter(&Default::default())) else {
+        assert!(
+            std::env::var_os("AURORA_REQUIRE_GPU").is_none(),
+            "Metal adapter required"
+        );
+        eprintln!("SKIP entity contract: no GPU adapter");
+        return;
+    };
+    eprintln!("Entity contract GPU: {:?}", adapter.get_info());
+    let (device, queue) = pollster::block_on(adapter.request_device(&Default::default())).unwrap();
+    let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);
+    let layout = bindings(&device);
+    let frame = NativeFrame::new(&device);
+    // Probe does not read shadows; the real archive GPU test covers those bindings.
+    let identity = NativeEntity::new(
+        &device,
+        &layout,
+        &frame,
+        None,
+        &stage("fn entity(i: EntityInput) -> vec4<f32> { return i.vanilla; }"),
+        &[],
+        wgpu::TextureFormat::Rgba8Unorm,
+    )
+    .unwrap();
+    let probe=NativeEntity::new(&device,&layout,&frame,None,
+        &stage("fn entity(i: EntityInput) -> vec4<f32> { return vec4(i.albedo.r, i.albedo.g * i.light.x, select(i.light.y, 0.9, i.hand), 1.0); }"),&[],wgpu::TextureFormat::Rgba8Unorm).unwrap();
+    let texture = |data: &[u8]| {
+        device
+            .create_texture_with_data(
+                &queue,
+                &wgpu::TextureDescriptor {
+                    label: None,
+                    size: wgpu::Extent3d {
+                        width: (data.len() / 4) as u32,
+                        height: 1,
+                        depth_or_array_layers: 1,
+                    },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format: wgpu::TextureFormat::Rgba8Unorm,
+                    usage: wgpu::TextureUsages::TEXTURE_BINDING,
+                    view_formats: &[],
+                },
+                wgpu::util::TextureDataOrder::LayerMajor,
+                data,
+            )
+            .create_view(&Default::default())
+    };
+    let atlas = texture(&[255, 255, 255, 255, 255, 255, 255, 0]);
+    let light = texture(&[255, 255, 255, 255]);
+    let glint = texture(&[50, 50, 50, 255]);
+    let sampler = device.create_sampler(&Default::default());
+    let globals = super::super::Globals {
+        view_proj: glam::Mat4::IDENTITY.to_cols_array_2d(),
+        fog: [1000.0, 2000.0, 1000.0, 2000.0],
+        fog_ends: [1000.0, 1000.0, 0.0, 1.0],
+        ..super::super::Globals::zeroed()
+    };
+    let uniform = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+        label: None,
+        contents: bytemuck::bytes_of(&globals),
+        usage: wgpu::BufferUsages::UNIFORM,
+    });
+    let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: None,
+        layout: &layout,
+        entries: &[
+            wgpu::BindGroupEntry {
+                binding: 0,
+                resource: uniform.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 1,
+                resource: wgpu::BindingResource::TextureView(&atlas),
+            },
+            wgpu::BindGroupEntry {
+                binding: 2,
+                resource: wgpu::BindingResource::Sampler(&sampler),
+            },
+            wgpu::BindGroupEntry {
+                binding: 3,
+                resource: wgpu::BindingResource::TextureView(&light),
+            },
+            wgpu::BindGroupEntry {
+                binding: 4,
+                resource: wgpu::BindingResource::Sampler(&sampler),
+            },
+            wgpu::BindGroupEntry {
+                binding: 5,
+                resource: wgpu::BindingResource::TextureView(&glint),
+            },
+            wgpu::BindGroupEntry {
+                binding: 6,
+                resource: wgpu::BindingResource::Sampler(&sampler),
+            },
+            wgpu::BindGroupEntry {
+                binding: 7,
+                resource: wgpu::BindingResource::TextureView(&glint),
+            },
+        ],
+    });
+    let mut vertices = Vec::new();
+    for case in 0..8 {
+        let x = -1.0 + case as f32 * 0.25;
+        for (dx, y) in [
+            (0.0, -1.0),
+            (0.25, -1.0),
+            (0.0, 1.0),
+            (0.0, 1.0),
+            (0.25, -1.0),
+            (0.25, 1.0),
+        ] {
+            vertices.push(super::super::Vertex {
+                pos: [x + dx, y, 0.5],
+                uv: [if case == 5 { 0.75 } else { 0.25 }, 0.5],
+                layer: match case {
+                    3 => 1,
+                    4 => 7,
+                    6 => 2,
+                    7 => 36,
+                    _ => 0,
+                },
+                color: u32::from_le_bytes([204, 153, 102, 255]),
+                light: if case == 2 {
+                    240 | (240 << 8)
+                } else {
+                    192 | (64 << 8)
+                },
+                normal: if case == 1 { [0; 4] } else { [0, 127, 0, 127] },
+                glint_uv: [0.5; 2],
+            });
+        }
+    }
+    let buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+        label: None,
+        contents: bytemuck::cast_slice(&vertices),
+        usage: wgpu::BufferUsages::VERTEX,
+    });
+    let size = wgpu::Extent3d {
+        width: 128,
+        height: 4,
+        depth_or_array_layers: 1,
+    };
+    let target = device.create_texture(&wgpu::TextureDescriptor {
+        label: None,
+        size,
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: wgpu::TextureFormat::Rgba8Unorm,
+        usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+        view_formats: &[],
+    });
+    let depth = device.create_texture(&wgpu::TextureDescriptor {
+        label: None,
+        size,
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: wgpu::TextureFormat::Depth32Float,
+        usage: wgpu::TextureUsages::RENDER_ATTACHMENT,
+        view_formats: &[],
+    });
+    let view = target.create_view(&Default::default());
+    let depth_view = depth.create_view(&Default::default());
+    let render = |pipeline: &wgpu::RenderPipeline| {
+        let mut encoder = device.create_command_encoder(&Default::default());
+        {
+            let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &view,
+                    resolve_target: None,
+                    depth_slice: None,
+                    ops: wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                    view: &depth_view,
+                    depth_ops: Some(wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(0.0),
+                        store: wgpu::StoreOp::Discard,
+                    }),
+                    stencil_ops: None,
+                }),
+                ..Default::default()
+            });
+            pass.set_pipeline(pipeline);
+            pass.set_bind_group(0, &group, &[]);
+            pass.set_bind_group(3, &frame.group, &[]);
+            pass.set_vertex_buffer(0, buffer.slice(..));
+            pass.draw(0..vertices.len() as u32, 0..1);
+        }
+        let read = device.create_buffer(&wgpu::BufferDescriptor {
+            label: None,
+            size: 2048,
+            usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            mapped_at_creation: false,
+        });
+        encoder.copy_texture_to_buffer(
+            target.as_image_copy(),
+            wgpu::TexelCopyBufferInfo {
+                buffer: &read,
+                layout: wgpu::TexelCopyBufferLayout {
+                    offset: 0,
+                    bytes_per_row: Some(512),
+                    rows_per_image: None,
+                },
+            },
+            size,
+        );
+        queue.submit([encoder.finish()]);
+        let (send, recv) = std::sync::mpsc::channel();
+        read.slice(..)
+            .map_async(wgpu::MapMode::Read, move |r| send.send(r).unwrap());
+        device
+            .poll(wgpu::PollType::Wait {
+                submission_index: None,
+                timeout: None,
+            })
+            .unwrap();
+        recv.recv().unwrap().unwrap();
+        let bytes = read.slice(..).get_mapped_range().unwrap();
+        let pixels: Vec<[u8; 4]> = (0..8)
+            .map(|i| {
+                bytes[512 + (i * 16 + 8) * 4..512 + (i * 16 + 8) * 4 + 4]
+                    .try_into()
+                    .unwrap()
+            })
+            .collect();
+        drop(bytes);
+        read.unmap();
+        pixels
+    };
+    let base = render(&identity.world);
+    let world = render(&probe.world);
+    let hand = render(&probe.hand);
+    for i in [1, 2, 5, 6] {
+        assert_eq!(world[i], base[i], "bypass case {i}");
+        assert_eq!(hand[i], base[i], "hand bypass {i}");
+    }
+    assert_eq!(&world[5][..3], &[0, 0, 0], "alpha discard");
+    for (have, want) in world[0][..3].iter().zip([204, 41, 204]) {
+        assert!(
+            (i32::from(*have) - want).abs() <= 1,
+            "clean tint/light order: {:?}",
+            world[0]
+        );
+    }
+    assert!((i32::from(hand[0][2]) - 230).abs() <= 1, "hand flag");
+    assert!(world[3][1] < world[0][1], "hurt overlay before lighting");
+    for i in [4, 7] {
+        for channel in 0..3 {
+            assert!(
+                (i32::from(world[i][channel]) - i32::from(world[0][channel]) - 10).abs() <= 1,
+                "glint after lighting"
+            );
+        }
+    }
+    assert!(pollster::block_on(scope.pop()).is_none());
+}
