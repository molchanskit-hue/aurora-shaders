diff --git a/crates/horizon-shader-api/src/sun_shadow_quality.wgsl b/crates/horizon-shader-api/src/sun_shadow_quality.wgsl
new file mode 100644
index 0000000..facdd93
--- /dev/null
+++ b/crates/horizon-shader-api/src/sun_shadow_quality.wgsl
@@ -0,0 +1,31 @@
+// shadow.2 material-only resources; constants come from the checked recipe. Engine-owned group 2 is reserved for this extension.
+struct SunShadow {
+    matrix: mat4x4<f32>,
+    // map texel size, receiver fade start/end (blocks), enabled
+    parameters: vec4<f32>,
+}
+@group(2) @binding(0) var sun_shadow_depth: texture_depth_2d;
+@group(2) @binding(1) var sun_shadow_sampler: sampler_comparison;
+@group(2) @binding(2) var<uniform> sun_shadow: SunShadow;
+
+// Camera-relative position, geometric world normal; 1 means unoccluded sunlight.
+fn sun_visibility(position: vec3<f32>, normal: vec3<f32>) -> f32 {
+    if sun_shadow.parameters.w < 0.5 { return 1.0; }
+    let clip = sun_shadow.matrix * vec4<f32>(position, 1.0);
+    let uv = clip.xy * vec2<f32>(0.5, -0.5) + vec2<f32>(0.5);
+    let border = sun_shadow.parameters.x * 3.0;
+    if any(uv < vec2<f32>(border)) || any(uv > vec2<f32>(1.0 - border))
+        || clip.z <= 0.0 || clip.z >= 1.0 { return 1.0; }
+    let slope = 1.0 - abs(dot(normal, frame.sun_direction));
+    let reference = clip.z - (0.00015 + 0.0004 * slope) * horizon_sun_bias_scale;
+    var visibility = 0.0;
+    for (var y: i32 = -horizon_sun_pcf_radius; y <= horizon_sun_pcf_radius; y += 1) {
+        for (var x: i32 = -horizon_sun_pcf_radius; x <= horizon_sun_pcf_radius; x += 1) {
+            visibility += textureSampleCompareLevel(sun_shadow_depth, sun_shadow_sampler,
+                uv + vec2<f32>(f32(x), f32(y)) * sun_shadow.parameters.x, reference);
+        }
+    }
+    let edge = smoothstep(0.0, 0.08, min(min(uv.x, uv.y), min(1.0-uv.x, 1.0-uv.y)));
+    let range = 1.0 - smoothstep(sun_shadow.parameters.y, sun_shadow.parameters.z, length(position));
+    return mix(1.0, visibility / horizon_sun_pcf_count, edge * range);
+}
