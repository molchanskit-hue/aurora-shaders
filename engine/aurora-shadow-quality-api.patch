+#[test]
+fn shadow_quality_manifest_is_explicit_and_versioned() {
+    let base = "schema=1\nid=\"t\"\nname=\"T\"\nversion=\"1\"\napi=\"0.1-aurora-shadow.2\"\n[material]\nfile=\"m.wgsl\"\n[[post]]\nfile=\"p.wgsl\"\n";
