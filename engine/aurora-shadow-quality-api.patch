+/// Fixed recipes shared by shader composition and GPU allocation.
+#[derive(Clone, Copy, Debug, Default, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+pub enum SunShadowQuality {
+    Low,
+    Medium,
+    #[default]
+    High,
+    Ultra,
+}
+impl SunShadowQuality {
+    pub fn enabled(self) -> bool {
+        self != Self::Low
+    }
+    /// Low retains only a dummy binding, with no caster pass.
+    pub fn size(self) -> u32 {
+        match self {
+            Self::Low => 1,
+            Self::Medium => 1024,
+            Self::High => 2048,
+            Self::Ultra => 4096,
+        }
+    }
+    pub fn radius(self) -> f32 {
+        match self {
+            Self::Low | Self::High => 48.0,
+            Self::Medium => 36.0,
+            Self::Ultra => 68.0,
+        }
+    }
+    pub fn fade(self) -> [f32; 2] {
+        match self {
+            Self::Low | Self::High => [32.0, 44.0],
+            Self::Medium => [22.0, 32.0],
+            Self::Ultra => [48.0, 64.0],
+        }
+    }
+    pub fn caster_distance(self) -> f32 {
+        if self == Self::Ultra { 128.0 } else { 96.0 }
+    }
+    pub fn pcf_radius(self) -> i32 {
+        if self == Self::Ultra { 2 } else { 1 }
+    }
+    pub fn bias_scale(self) -> f32 {
+        if self.enabled() {
+            (2.0 * self.radius() / self.size() as f32) / (96.0 / 2048.0)
+        } else {
+            1.0
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct SunShadows {
+    pub quality: SunShadowQuality,
 }
