+        let text = format!("{base}\n[sun_shadows]\nquality=\"{quality}\"\n");
+        assert!(Manifest::parse(&text).is_ok());
+        for old in ["0.1", "0.1-aurora-water.3", "0.1-aurora-shadow.1"] {
+            assert!(
+                Manifest::parse(&text.replace("0.1-aurora-shadow.2", old))
+                    .unwrap_err()
+                    .contains("requires API")
+            );
+        }
+        assert!(Manifest::parse(&text.replace("[material]\nfile=\"m.wgsl\"\n", "")).is_err());
+        assert!(Manifest::parse(&format!("{text}size=16384\n")).is_err());
+    }
+    for invalid in ["", "High", "extreme"] {
+        assert!(Manifest::parse(&format!("{base}[sun_shadows]\nquality=\"{invalid}\"\n")).is_err());
