+    // Exercise an actual GPU: the source can change after capture, resize rebinds
+    // both images, and a second frame must replace (not reuse) the snapshot.
+    #[test]
+    fn snapshot_is_independent_fresh_and_resized() {
+        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor::new_without_display_handle());
+        let Ok(adapter) = pollster::block_on(instance.request_adapter(&Default::default())) else {
+            eprintln!("SKIP native_scene GPU test: no adapter");
+            return;
+        };
+        eprintln!("Snapshot test adapter: {:?}", adapter.get_info());
+        let (device, queue) =
+            pollster::block_on(adapter.request_device(&Default::default())).unwrap();
+        let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);
+        let format = wgpu::TextureFormat::Rgba8Unorm;
+        let frame = NativeFrame::new(&device);
+        let mut scene = NativeScene::new(&device, format);
+        let manifest = "schema=1\nid=\"t\"\nname=\"Test\"\nversion=\"1\"\napi=\"0.1\"\n[[post]]\nfile=\"a.wgsl\"\n";
+        let shader = "fn post(i: PostInput) -> vec4<f32> { return vec4(i.color.rgb, i.depth); }";
+        let files = [(MANIFEST, manifest), ("a.wgsl", shader)]
+            .map(|(k, v)| (k.into(), v.as_bytes().to_vec()))
+            .into();
+        let report = check(&Pack::from_files(files).unwrap()).unwrap();
+        let mut post = NativePost::new(&device, report.stages, &[], format, &frame).unwrap();
+        for size in [[4, 4], [8, 4]] {
+            let texture = |format, usage| {
+                device.create_texture(&wgpu::TextureDescriptor {
+                    label: None,
+                    size: wgpu::Extent3d {
+                        width: size[0],
+                        height: size[1],
+                        depth_or_array_layers: 1,
+                    },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format,
+                    usage,
+                    view_formats: &[],
+                })
+            };
+            let usage =
+                wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::TEXTURE_BINDING;
+            let color = texture(format, usage).create_view(&Default::default());
+            let depth =
+                texture(wgpu::TextureFormat::Depth32Float, usage).create_view(&Default::default());
+            let output = texture(
+                format,
+                wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+            );
+            let view = output.create_view(&Default::default());
+            for (red, z) in [(0.25, 0.75), (0.5, 0.125)] {
+                scene.prepare(&device, &frame, (&color, &depth), size);
+                let mut encoder = device.create_command_encoder(&Default::default());
+                let clear = |encoder: &mut wgpu::CommandEncoder, red, z| {
+                    encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                        color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                            view: &color,
+                            resolve_target: None,
+                            depth_slice: None,
+                            ops: wgpu::Operations {
+                                load: wgpu::LoadOp::Clear(wgpu::Color {
+                                    r: red,
+                                    g: 0.25,
+                                    b: 0.5,
+                                    a: 1.0,
+                                }),
+                                store: wgpu::StoreOp::Store,
+                            },
+                        })],
+                        depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                            view: &depth,
+                            depth_ops: Some(wgpu::Operations {
+                                load: wgpu::LoadOp::Clear(z),
+                                store: wgpu::StoreOp::Store,
+                            }),
+                            stencil_ops: None,
+                        }),
+                        ..Default::default()
+                    });
+                };
+                clear(&mut encoder, red, z);
+                scene.capture(&mut encoder);
+                clear(&mut encoder, 1.0, 0.0);
+                let targets = scene.targets.as_ref().unwrap();
+                post.run(
+                    &device,
+                    &mut encoder,
+                    (&targets.color, &targets.depth),
+                    &view,
+                    size,
+                    None,
+                );
+                let buffer = device.create_buffer(&wgpu::BufferDescriptor {
+                    label: None,
+                    size: u64::from(256 * size[1]),
+                    usage: wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST,
+                    mapped_at_creation: false,
+                });
+                encoder.copy_texture_to_buffer(
+                    output.as_image_copy(),
+                    wgpu::TexelCopyBufferInfo {
+                        buffer: &buffer,
+                        layout: wgpu::TexelCopyBufferLayout {
+                            offset: 0,
+                            bytes_per_row: Some(256),
+                            rows_per_image: Some(size[1]),
+                        },
+                    },
+                    output.size(),
+                );
+                queue.submit([encoder.finish()]);
+                buffer
+                    .slice(..)
+                    .map_async(wgpu::MapMode::Read, |r| r.unwrap());
+                device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+                let bytes = buffer.slice(..).get_mapped_range().unwrap();
+                for y in 0..size[1] as usize {
+                    for x in 0..size[0] as usize {
+                        let pixel = &bytes[y * 256 + x * 4..y * 256 + x * 4 + 4];
+                        let want = [(red * 255.0) as u8, 64, 128, (z * 255.0) as u8];
+                        assert!(
+                            pixel.iter().zip(want).all(|(a, b)| a.abs_diff(b) <= 1),
+                            "{pixel:?} != {want:?}, size {size:?}"
+                        );
+                    }
+                }
+            }
+        }
+        assert!(pollster::block_on(scope.pop()).is_none());
+    }
+}
