+#[test]
+fn temporal_post_contract_rejects_legacy_and_invalid_targets() {
+    let base = "schema=1\nid=\"t\"\nname=\"T\"\nversion=\"1\"\napi=\"0.1-aurora-atmosphere.2\"\n[sun_shadows]\nquality=\"high\"\n[material]\nfile=\"m.wgsl\"\n[[post]]\nfile=\"h.wgsl\"\nresolution_divisor=2\nhistory=true\n[[post]]\nfile=\"p.wgsl\"\n";
+    assert!(Manifest::parse(base).is_ok());
+    for old in ["0.1-aurora-atmosphere.1", "0.1-aurora-shadow.2"] {
+        assert!(
+            Manifest::parse(&base.replace("0.1-aurora-atmosphere.2", old))
+                .unwrap_err()
+                .contains("require atmosphere.2")
+        );
+    }
+    for bad in [0, 3, 8, 1000] {
+        assert!(
+            Manifest::parse(
+                &base.replace("resolution_divisor=2", &format!("resolution_divisor={bad}"))
+            )
+            .is_err()
+        );
+    }
+    assert!(Manifest::parse(&format!("{base}resolution_divisor=2\n")).is_err());
+    assert!(Manifest::parse(&format!("{base}history=true\n")).is_err());
+    assert!(
+        Manifest::parse(&base.replace("file=\"m.wgsl\"", "file=\"m.wgsl\"\nhistory=false"))
+            .is_err()
+    );
+    let two = base.replace(
+        "[[post]]\nfile=\"p.wgsl\"",
+        "[[post]]\nfile=\"h2.wgsl\"\nhistory=true\n[[post]]\nfile=\"p.wgsl\"",
+    );
+    assert!(Manifest::parse(&two).unwrap_err().contains("one history"));
