+++ b/crates/horizon-client-render/src/gfx/native_post/temporal.rs
@@ -0,0 +1,429 @@
+//! atmosphere.2 only: scaled intermediates and one explicitly retained post result.
+use super::*;
+use std::collections::BTreeMap;
+
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+struct HistoryUniform {
+    previous_view_projection: [[f32; 4]; 4],
+    camera_delta: [f32; 4],
+    clock: [f32; 4],
+}
+
+pub(super) fn entries() -> [wgpu::BindGroupLayoutEntry; 3] {
+    [
+        texture_entry(6, wgpu::TextureSampleType::Float { filterable: true }),
+        texture_entry(7, wgpu::TextureSampleType::Float { filterable: false }),
+        wgpu::BindGroupLayoutEntry {
+            binding: 8,
+            visibility: wgpu::ShaderStages::FRAGMENT,
+            ty: wgpu::BindingType::Buffer {
+                ty: wgpu::BufferBindingType::Uniform,
+                has_dynamic_offset: false,
+                min_binding_size: wgpu::BufferSize::new(size_of::<HistoryUniform>() as u64),
+            },
+            count: None,
+        },
+    ]
+}
+
+fn scaled(size: [u32; 2], divisor: u32) -> [u32; 2] {
+    size.map(|n| n.max(1).div_ceil(divisor))
+}
+
+/// Camera cuts, changed projection/environment and stale/nonconsecutive frames reject history.
+fn reusable(previous: &FrameInputs, current: &FrameInputs) -> bool {
+    let delta = Vec3::from(current.camera_position) - Vec3::from(previous.camera_position);
+    let forward =
+        |f: &FrameInputs| Mat4::from_cols_array_2d(&f.view_inverse).transform_vector3(-Vec3::Z);
+    let day_delta = (current.day_time - previous.day_time).abs();
+    let projection_delta = current
+        .projection
+        .iter()
+        .flatten()
+        .zip(previous.projection.iter().flatten())
+        .map(|(a, b)| (a - b).abs())
+        .fold(0.0_f32, f32::max);
+    current.frame_index == previous.frame_index.wrapping_add(1)
+        && current.dimension == previous.dimension
+        && current.eye_in == previous.eye_in
+        && delta.is_finite()
+        && delta.length_squared() < 64.0
+        && forward(previous).dot(forward(current)) > 0.8
+        && projection_delta < 0.02
+        && (current.time - previous.time).rem_euclid(3600.0) < 0.25
+        && day_delta.min(1.0 - day_delta) < 0.01
+        && (current.rain - previous.rain).abs() < 0.1
+        && (current.thunder - previous.thunder).abs() < 0.1
+}
+
+struct Resources {
+    size: [u32; 2],
+    world: WorldViews,
+    targets: BTreeMap<u32, [wgpu::Texture; 2]>,
+    views: BTreeMap<u32, [wgpu::TextureView; 2]>,
+    history: wgpu::Texture,
+    depth: wgpu::TextureView,
+    groups: Vec<wgpu::BindGroup>,
+    depth_group: wgpu::BindGroup,
+}
+
+pub(super) struct TemporalPost {
+    divisors: Vec<u32>,
+    history_index: Option<usize>,
+    uniform: wgpu::Buffer,
+    depth_layout: wgpu::BindGroupLayout,
+    depth_pipeline: wgpu::RenderPipeline,
+    resources: Option<Resources>,
+    previous: Option<FrameInputs>,
+}
+
+impl TemporalPost {
+    pub fn new(device: &wgpu::Device, stages: &[CheckedStage]) -> Self {
+        let uniform = device.create_buffer(&wgpu::BufferDescriptor {
+            label: Some("Aurora post history camera"),
+            size: size_of::<HistoryUniform>() as u64,
+            usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        });
+        let depth_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("Aurora history depth"),
+            entries: &[texture_entry(0, wgpu::TextureSampleType::Depth)],
+        });
+        let layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("Aurora history depth"),
+            bind_group_layouts: &[Some(&depth_layout)],
+            ..Default::default()
+        });
+        let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("Aurora history depth snapshot"),
+            source: wgpu::ShaderSource::Wgsl(include_str!("history_depth.wgsl").into()),
+        });
+        let depth_pipeline = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some("Aurora history depth snapshot"),
+            layout: Some(&layout),
+            vertex: wgpu::VertexState {
+                module: &module,
+                entry_point: Some("vs"),
+                buffers: &[],
+                compilation_options: Default::default(),
+            },
+            primitive: Default::default(),
+            depth_stencil: None,
+            multisample: Default::default(),
+            fragment: Some(wgpu::FragmentState {
+                module: &module,
+                entry_point: Some("fs"),
+                compilation_options: Default::default(),
+                targets: &[Some(wgpu::ColorTargetState {
+                    format: wgpu::TextureFormat::R32Float,
+                    blend: None,
+                    write_mask: wgpu::ColorWrites::ALL,
+                })],
+            }),
+            multiview_mask: None,
+            cache: None,
+        });
+        Self {
+            divisors: stages.iter().map(|s| s.resolution_divisor).collect(),
+            history_index: stages.iter().position(|s| s.history),
+            uniform,
+            depth_layout,
+            depth_pipeline,
+            resources: None,
+            previous: None,
+        }
+    }
+
+    fn prepare(
+        &mut self,
+        parent: &NativePost,
+        device: &wgpu::Device,
+        world: (&wgpu::TextureView, &wgpu::TextureView),
+        size: [u32; 2],
+    ) {
+        if self
+            .resources
+            .as_ref()
+            .is_some_and(|r| r.size == size && &r.world.0 == world.0 && &r.world.1 == world.1)
+        {
+            return;
+        }
+        let texture = |label, dimensions: [u32; 2], format, usage| {
+            device.create_texture(&wgpu::TextureDescriptor {
+                label: Some(label),
+                size: wgpu::Extent3d {
+                    width: dimensions[0],
+                    height: dimensions[1],
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format,
+                usage,
+                view_formats: &[],
+            })
+        };
+        let sampled = wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::RENDER_ATTACHMENT;
+        let mut targets = BTreeMap::new();
+        for divisor in self.divisors.iter().take(self.divisors.len() - 1) {
+            targets.entry(*divisor).or_insert_with(|| {
+                std::array::from_fn(|_| {
+                    texture(
+                        "Aurora scaled post",
+                        scaled(size, *divisor),
+                        INTERMEDIATE,
+                        sampled | wgpu::TextureUsages::COPY_SRC,
+                    )
+                })
+            });
+        }
+        let views: BTreeMap<_, _> = targets
+            .iter()
+            .map(|(k, t)| (*k, t.each_ref().map(|t| t.create_view(&Default::default()))))
+            .collect();
+        let history_size = self
+            .history_index
+            .map_or([1, 1], |i| scaled(size, self.divisors[i]));
+        let history = texture(
+            "Aurora previous cloud frame",
+            history_size,
+            INTERMEDIATE,
+            wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+        );
+        let history_view = history.create_view(&Default::default());
+        let depth = texture(
+            "Aurora previous scene depth",
+            history_size,
+            wgpu::TextureFormat::R32Float,
+            sampled,
+        )
+        .create_view(&Default::default());
+        let groups = (0..self.divisors.len())
+            .map(|i| {
+                let previous = if i == 0 {
+                    world.0
+                } else {
+                    &views[&self.divisors[i - 1]][(i - 1) % 2]
+                };
+                device.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: Some("Aurora temporal post resources"),
+                    layout: &parent.layout,
+                    entries: &[
+                        wgpu::BindGroupEntry {
+                            binding: 0,
+                            resource: parent.frame.as_entire_binding(),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 1,
+                            resource: wgpu::BindingResource::TextureView(world.0),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 2,
+                            resource: wgpu::BindingResource::TextureView(world.1),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 3,
+                            resource: wgpu::BindingResource::TextureView(previous),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 4,
+                            resource: wgpu::BindingResource::Sampler(&parent.linear),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 5,
+                            resource: wgpu::BindingResource::Sampler(&parent.nearest),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 6,
+                            resource: wgpu::BindingResource::TextureView(&history_view),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 7,
+                            resource: wgpu::BindingResource::TextureView(&depth),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 8,
+                            resource: self.uniform.as_entire_binding(),
+                        },
+                    ],
+                })
+            })
+            .collect();
+        let depth_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("Aurora history scene depth"),
+            layout: &self.depth_layout,
+            entries: &[wgpu::BindGroupEntry {
+                binding: 0,
+                resource: wgpu::BindingResource::TextureView(world.1),
+            }],
+        });
+        self.resources = Some(Resources {
+            size,
+            world: (world.0.clone(), world.1.clone()),
+            targets,
+            views,
+            history,
+            depth,
+            groups,
+            depth_group,
+        });
+        self.previous = None;
+    }
+
+    pub fn run(
+        &mut self,
+        parent: &NativePost,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        encoder: &mut wgpu::CommandEncoder,
+        world: (&wgpu::TextureView, &wgpu::TextureView),
+        screen: &wgpu::TextureView,
+        size: [u32; 2],
+        current: Option<FrameInputs>,
+        mut timing: Option<&mut super::super::pack_timing::PassTiming>,
+    ) {
+        self.prepare(parent, device, world, size);
+        let current = current.unwrap_or_default();
+        let valid = self.history_index.is_some()
+            && self
+                .previous
+                .as_ref()
+                .is_some_and(|p| reusable(p, &current));
+        let previous = self.previous.unwrap_or(current);
+        let vp = Mat4::from_cols_array_2d(&previous.projection)
+            * Mat4::from_cols_array_2d(&previous.view);
+        let delta = Vec3::from(current.camera_position) - Vec3::from(previous.camera_position);
+        queue.write_buffer(
+            &self.uniform,
+            0,
+            bytemuck::bytes_of(&HistoryUniform {
+                previous_view_projection: vp.to_cols_array_2d(),
+                camera_delta: [delta.x, delta.y, delta.z, f32::from(u8::from(valid))],
+                clock: [previous.time, current.time, 0.0, 0.0],
+            }),
+        );
+        if let Some(t) = timing.as_deref_mut() {
+            t.mark(device, encoder, (world.0, parent.format));
+        }
+        let r = self.resources.as_ref().unwrap();
+        for (i, (label, pipeline)) in parent.passes.iter().enumerate() {
+            let view = if i + 1 == parent.passes.len() {
+                screen
+            } else {
+                &r.views[&self.divisors[i]][i % 2]
+            };
+            {
+                let attachments = [Some(wgpu::RenderPassColorAttachment {
+                    view,
+                    resolve_target: None,
+                    depth_slice: None,
+                    ops: wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                        store: wgpu::StoreOp::Store,
+                    },
+                })];
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some(label),
+                    color_attachments: &attachments,
+                    timestamp_writes: timing.as_deref_mut().and_then(|t| t.writes(label)),
+                    ..Default::default()
+                });
+                pass.set_pipeline(pipeline);
+                if let Some(shadow) = &parent.sun_shadow {
+                    pass.set_bind_group(2, shadow, &[]);
+                }
+                pass.set_bind_group(GROUP, &r.groups[i], &[]);
+                pass.draw(0..3, 0..1);
+            }
+            if self.history_index == Some(i) {
+                let source = &r.targets[&self.divisors[i]][i % 2];
+                encoder.copy_texture_to_texture(
+                    source.as_image_copy(),
+                    r.history.as_image_copy(),
+                    source.size(),
+                );
+            }
+        }
+        if self.history_index.is_some() {
+            // Store depth after every consumer has finished reading the previous frame.
+            let attachments = [Some(wgpu::RenderPassColorAttachment {
+                view: &r.depth,
+                resolve_target: None,
+                depth_slice: None,
+                ops: wgpu::Operations {
+                    load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                    store: wgpu::StoreOp::Store,
+                },
+            })];
+            let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("Aurora history depth snapshot"),
+                color_attachments: &attachments,
+                ..Default::default()
+            });
+            pass.set_pipeline(&self.depth_pipeline);
+            pass.set_bind_group(0, &r.depth_group, &[]);
+            pass.draw(0..3, 0..1);
+        }
+        self.previous = Some(current);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn input(index: u32) -> FrameInputs {
+        FrameInputs {
+            frame_index: index,
+            projection: Mat4::IDENTITY.to_cols_array_2d(),
+            view_inverse: Mat4::IDENTITY.to_cols_array_2d(),
+            ..Default::default()
+        }
+    }
+    #[test]
+    fn history_accepts_motion_but_rejects_cuts_and_environment_changes() {
+        let p = input(0);
+        let mut c = input(1);
+        c.camera_position = [0.2, 0.0, 0.0];
+        c.time = 0.016;
+        assert!(reusable(&p, &c));
+        c.camera_position[0] = 8.0;
+        assert!(!reusable(&p, &c));
+        c.camera_position[0] = 0.0;
+        c.dimension = 1;
+        assert!(!reusable(&p, &c));
+        c.dimension = 0;
+        c.eye_in = 1;
+        assert!(!reusable(&p, &c));
+        c.eye_in = 0;
+        c.projection[0][0] += 0.1;
+        assert!(!reusable(&p, &c));
+        c.projection[0][0] -= 0.1;
+        c.view_inverse = Mat4::from_rotation_y(1.0).to_cols_array_2d();
+        assert!(!reusable(&p, &c));
+        c.view_inverse = p.view_inverse;
+        c.day_time = 0.25;
+        assert!(!reusable(&p, &c));
+        c.day_time = 0.0;
+        c.time = 1.0;
+        assert!(!reusable(&p, &c));
+        c.time = 0.016;
+        c.frame_index = 3;
+        assert!(!reusable(&p, &c));
+    }
+    #[test]
+    fn odd_sizes_and_clock_wrap_are_supported() {
+        assert_eq!(scaled([5, 3], 2), [3, 2]);
+        assert_eq!(scaled([1, 1], 4), [1, 1]);
+        let mut p = input(u32::MAX);
+        p.time = 3599.99;
+        p.day_time = 0.9999;
+        assert!(reusable(&p, &input(0)));
+        assert_eq!(size_of::<HistoryUniform>(), 96);
+    }
+}
