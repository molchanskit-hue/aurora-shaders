@@ -0,0 +1,10 @@
+@group(0) @binding(0) var scene: texture_depth_2d;
+struct Out { @builtin(position) position: vec4<f32>, @location(0) uv: vec2<f32>, }
+@vertex fn vs(@builtin(vertex_index) i: u32) -> Out {
+    let p = vec2(f32((i << 1u) & 2u), f32(i & 2u));
+    return Out(vec4(p * 2.0 - 1.0, 0.0, 1.0), vec2(p.x, 1.0-p.y));
+}
+@fragment fn fs(i: Out) -> @location(0) f32 {
+    let size = vec2<f32>(textureDimensions(scene));
+    return textureLoad(scene, vec2<i32>(clamp(i.uv * size, vec2(0.0), size-1.0)), 0);
+}
diff --git a/crates/horizon-client-render/src/gfx/native_post/temporal.rs b/crates/horizon-client-render/src/gfx/native_post/temporal.rs
