+// atmosphere.2 post history. Only the stage marked history=true may consume it.
+struct PostHistoryFrame {
+    previous_view_projection: mat4x4<f32>,
+    // xyz: current camera minus previous camera; w: 1 only for reusable history.
+    camera_delta: vec4<f32>,
+    // x: previous wrapped seconds, y: current wrapped seconds; z/w reserved.
+    clock: vec4<f32>,
+}
+@group(3) @binding(6) var history_color: texture_2d<f32>;
+@group(3) @binding(7) var history_depth: texture_2d<f32>;
+@group(3) @binding(8) var<uniform> post_history: PostHistoryFrame;
+fn history_depth_at(uv: vec2<f32>) -> f32 {
+    let size = vec2<f32>(textureDimensions(history_depth));
+    return textureLoad(history_depth, vec2<i32>(clamp(uv * size, vec2(0.0), size - 1.0)), 0).r;
+}
