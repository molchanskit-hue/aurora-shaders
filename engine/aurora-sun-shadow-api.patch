new file mode 100644
index 0000000..0fbd1d3
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/native_shadow.wgsl
@@ -0,0 +1,17 @@
+struct AuroraSun { matrix: mat4x4<f32>, parameters: vec4<f32>, }
+@group(2) @binding(2) var<uniform> aurora_sun: AuroraSun;
+struct SunVertex {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+    @location(1) @interpolate(flat) layer: u32,
+}
+@vertex fn vs_sun(@location(0) position: vec3<f32>, @location(1) uv: vec2<u32>,
+    @location(2) layer: u32, @location(3) color: vec4<f32>, @location(4) light: vec2<u32>,
+    @location(5) origin: vec4<f32>) -> SunVertex {
+    return SunVertex(aurora_sun.matrix * vec4<f32>(position + origin.xyz, 1.0),
+        horizon_terrain_terrain_uv(uv, origin.w), layer);
+}
+@fragment fn fs_sun(input: SunVertex) {
+    let alpha = horizon_terrain_sprite(input.uv, input.layer & 0x7fffu).a;
+    if alpha < 0.5 && (input.layer & 0x8000u) == 0u { discard; }
+}
diff --git a/crates/horizon-client-render/src/gfx/native_shadow_tests.rs b/crates/horizon-client-render/src/gfx/native_shadow_tests.rs
