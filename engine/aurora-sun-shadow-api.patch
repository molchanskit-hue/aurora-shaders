diff --git a/crates/horizon-client-render/src/gfx/native_shadow.rs b/crates/horizon-client-render/src/gfx/native_shadow.rs
new file mode 100644
index 0000000..ed95989
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/native_shadow.rs
@@ -0,0 +1,267 @@
+//! Aurora shadow.1: one texel-stabilized orthographic map for opaque/cutout terrain.
+//! Camera-independent caster visibility; no entities, translucent casters or LOD meshes.
+use super::{
+    Frame,
+    native_material::{TerrainShape, vanilla_terrain},
+    pack_post::ShadowView,
+};
+use glam::{DMat4, DVec3, Mat4, Vec3};
+
+pub(super) const SIZE: u32 = 2048;
+const RADIUS: f32 = 48.0;
+const CASTER_DISTANCE: f32 = 96.0;
+
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+struct Uniform {
+    matrix: [[f32; 4]; 4],
+    parameters: [f32; 4],
+}
+
+pub struct NativeShadow {
+    pub layout: wgpu::BindGroupLayout,
+    pub receiver: wgpu::BindGroup,
+    pub caster: wgpu::BindGroup,
+    pub pipeline: wgpu::RenderPipeline,
+    pub depth: wgpu::TextureView,
+    uniform: wgpu::Buffer,
+}
+
+// Only x/y snap: preserving continuous depth avoids depth jumps during translation.
+fn matrix(camera: DVec3, light: Vec3) -> Mat4 {
+    let rotation = DMat4::look_to_rh(DVec3::ZERO, -light.as_dvec3(), DVec3::Z);
+    let at = rotation.transform_vector3(camera);
+    let step = f64::from(2.0 * RADIUS / SIZE as f32);
+    let offset = DVec3::new(
+        at.x - (at.x / step).floor() * step,
+        at.y - (at.y / step).floor() * step,
+        -128.0,
+    );
+    Mat4::orthographic_rh(-RADIUS, RADIUS, -RADIUS, RADIUS, 0.1, 256.0)
+        * (DMat4::from_translation(offset) * rotation).as_mat4()
+}
+
+pub(super) fn view(frame: &Frame) -> Option<ShadowView> {
+    let a = frame.sky.sun_angle.to_radians();
+    let light = Vec3::new(-a.sin(), a.cos(), 0.0);
+    if frame.title || frame.nether_lighting || frame.end_sky || light.y <= 0.05 {
+        return None;
+    }
+    Some(ShadowView {
+        cull: matrix(frame.camera, light),
+        light,
+        distance: Some(CASTER_DISTANCE),
+    })
+}
+
+impl NativeShadow {
+    pub fn new(device: &wgpu::Device, shape: &TerrainShape<'_>) -> Self {
+        let uniform_entry = wgpu::BindGroupLayoutEntry {
+            binding: 2,
+            visibility: wgpu::ShaderStages::VERTEX_FRAGMENT,
+            ty: wgpu::BindingType::Buffer {
+                ty: wgpu::BufferBindingType::Uniform,
+                has_dynamic_offset: false,
+                min_binding_size: wgpu::BufferSize::new(80),
+            },
+            count: None,
+        };
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("Aurora sunlight receiver"),
+            entries: &[
+                super::native_post::texture_entry(0, wgpu::TextureSampleType::Depth),
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Comparison),
+                    count: None,
+                },
+                uniform_entry,
+            ],
+        });
+        let caster_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("Aurora sunlight caster"),
+            entries: &[uniform_entry],
+        });
+        let uniform = device.create_buffer(&wgpu::BufferDescriptor {
+            label: Some("Aurora sun matrix"),
+            size: 80,
+            usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        });
+        let depth = device
+            .create_texture(&wgpu::TextureDescriptor {
+                label: Some("Aurora sun depth"),
+                size: wgpu::Extent3d {
+                    width: SIZE,
+                    height: SIZE,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: wgpu::TextureFormat::Depth32Float,
+                usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                    | wgpu::TextureUsages::TEXTURE_BINDING,
+                view_formats: &[],
+            })
+            .create_view(&Default::default());
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("Aurora PCF"),
+            compare: Some(wgpu::CompareFunction::LessEqual),
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            ..Default::default()
+        });
+        let receiver = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("Aurora sunlight receiver"),
+            layout: &layout,
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(&depth),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::Sampler(&sampler),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 2,
+                    resource: uniform.as_entire_binding(),
+                },
+            ],
+        });
+        let caster = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("Aurora sunlight caster"),
+            layout: &caster_layout,
+            entries: &[wgpu::BindGroupEntry {
+                binding: 2,
+                resource: uniform.as_entire_binding(),
+            }],
+        });
+        let source = format!(
+            "{}\n{}",
+            vanilla_terrain(),
+            include_str!("native_shadow.wgsl")
+        );
+        let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("Aurora sun casters"),
+            source: wgpu::ShaderSource::Wgsl(source.into()),
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("Aurora sun casters"),
+            bind_group_layouts: &[Some(shape.globals), None, Some(&caster_layout)],
+            ..Default::default()
+        });
+        let constants = [
+            ("horizon_terrain_SPRITE_ARRAYS", shape.sprites[0]),
+            ("horizon_terrain_SPRITE_SPLIT", shape.sprites[1]),
+        ];
+        let options = wgpu::PipelineCompilationOptions {
+            constants: &constants,
+            ..Default::default()
+        };
+        let pipeline = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some("Aurora sun terrain depth"),
+            layout: Some(&pipeline_layout),
+            vertex: wgpu::VertexState {
+                module: &module,
+                entry_point: Some("vs_sun"),
+                compilation_options: options.clone(),
+                buffers: &[
+                    Some(wgpu::VertexBufferLayout {
+                        array_stride: size_of::<super::TerrainVertex>() as u64,
+                        step_mode: wgpu::VertexStepMode::Vertex,
+                        attributes: &super::TERRAIN_ATTRIBUTES,
+                    }),
+                    Some(wgpu::VertexBufferLayout {
+                        array_stride: 16,
+                        step_mode: wgpu::VertexStepMode::Instance,
+                        attributes: &wgpu::vertex_attr_array![5=>Float32x4],
+                    }),
+                ],
+            },
+            primitive: wgpu::PrimitiveState {
+                cull_mode: None,
+                ..Default::default()
+            },
+            depth_stencil: Some(wgpu::DepthStencilState {
+                format: wgpu::TextureFormat::Depth32Float,
+                depth_write_enabled: Some(true),
+                depth_compare: Some(wgpu::CompareFunction::LessEqual),
+                stencil: Default::default(),
+                bias: wgpu::DepthBiasState {
+                    constant: 2,
+                    slope_scale: 2.0,
+                    clamp: 0.0,
+                },
+            }),
+            multisample: Default::default(),
+            fragment: Some(wgpu::FragmentState {
+                module: &module,
+                entry_point: Some("fs_sun"),
+                compilation_options: options,
+                targets: &[],
+            }),
+            multiview_mask: None,
+            cache: None,
+        });
+        Self {
+            layout,
+            receiver,
+            caster,
+            pipeline,
+            depth,
+            uniform,
+        }
+    }
+
+    pub(super) fn prepare(&self, queue: &wgpu::Queue, frame: &Frame) {
+        let view = view(frame);
+        let data = Uniform {
+            matrix: view
+                .as_ref()
+                .map_or(Mat4::IDENTITY, |v| v.cull)
+                .to_cols_array_2d(),
+            parameters: [
+                1.0 / SIZE as f32,
+                32.0,
+                44.0,
+                if view.is_some() { 1.0 } else { 0.0 },
+            ],
+        };
+        queue.write_buffer(&self.uniform, 0, bytemuck::bytes_of(&data));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn projection_depth_and_texel_stability() {
+        let light = Vec3::new(-0.6, 0.8, 0.0);
+        let camera = DVec3::new(100000.013, 64.021, -200000.027);
+        let m = matrix(camera, light);
+        let p = m.project_point3(Vec3::ZERO);
+        let toward = m.project_point3(light * 10.0);
+        assert!(p.z > 0.0 && p.z < 1.0);
+        assert!(toward.z < p.z, "sunward caster must have smaller depth");
+        // Arbitrary camera translation changes a fixed world's UV by integer texels only.
+        let moved = camera + DVec3::new(0.013, 0.019, -0.011);
+        let q = matrix(moved, light).project_point3((camera - moved).as_vec3());
+        for d in [
+            (q.x - p.x) * SIZE as f32 * 0.5,
+            (q.y - p.y) * SIZE as f32 * 0.5,
+        ] {
+            assert!((d - d.round()).abs() < 0.001, "unstable texel delta {d}");
+        }
+        for angle in [0.0_f32, 45.0, 80.0] {
+            let a = angle.to_radians();
+            assert!(matrix(camera, Vec3::new(-a.sin(), a.cos(), 0.0)).is_finite());
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "native_shadow_tests.rs"]
+mod gpu_tests;
