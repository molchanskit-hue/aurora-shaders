+        .map(|(pos, uv)| {
+            let mut v = super::super::TerrainVertex::zeroed();
+            v.pos = pos;
+            v.uv = uv;
+            v
+        })
+        .collect();
+    let buffer = |data: &[u8], usage| {
+        device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: None,
+            contents: data,
+            usage,
+        })
+    };
+    let vertices = buffer(bytemuck::cast_slice(&vertices), wgpu::BufferUsages::VERTEX);
+    let origins = buffer(
+        bytemuck::cast_slice(&[0.0_f32, 0.0, 0.0, 1.0 / 32768.0]),
+        wgpu::BufferUsages::VERTEX,
+    );
+    let indices = buffer(
+        bytemuck::cast_slice(&[0u32, 1, 2, 0, 2, 3]),
+        wgpu::BufferUsages::INDEX,
+    );
+    let frame = super::super::native_post::NativeFrame::new(&device);
+    let mut inputs = horizon_shader_api::Frame::zeroed();
+    inputs.sun_direction = [0.0, 1.0, 0.0];
+    queue.write_buffer(&frame.buffer, 0, bytemuck::bytes_of(&inputs));
+    let source = horizon_shader_api::StageKind::Material.prelude_for("0.1-aurora-shadow.1")
+        + "
+        @vertex fn vs(@builtin(vertex_index) i:u32)->@builtin(position) vec4<f32> {
+            let p=vec2<f32>(f32((i<<1u)&2u),f32(i&2u)); return vec4(p*2.0-1.0,0.0,1.0); }
