+        label: None,
+        layout: &globals_layout,
+        entries: &bindings,
+    });
+    let points = [
+        ([-0.8, -0.8, 0.25], [0, 32768]),
+        ([0.8, -0.8, 0.25], [32768, 32768]),
+        ([0.8, 0.8, 0.25], [32768, 0]),
+        ([-0.8, 0.8, 0.25], [0, 0]),
