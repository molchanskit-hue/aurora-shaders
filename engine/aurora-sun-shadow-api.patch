+++ b/crates/horizon-client-render/src/gfx/native_shadow_tests.rs
@@ -0,0 +1,293 @@
+//! Real caster → comparison-sampler receiver: cutout must transmit, opaque must occlude.
+use super::*;
+use bytemuck::Zeroable;
+use wgpu::util::DeviceExt;
+
+#[test]
+fn cutout_caster_and_receiver_on_gpu() {
+    let instance = wgpu::Instance::new(wgpu::InstanceDescriptor::new_without_display_handle());
+    let Ok(adapter) = pollster::block_on(instance.request_adapter(&Default::default())) else {
+        assert!(
+            std::env::var_os("AURORA_REQUIRE_GPU").is_none(),
+            "Metal adapter required for the Aurora preview"
+        );
+        eprintln!("SKIP sunlight GPU test: no adapter");
+        return;
+    };
+    eprintln!("Sunlight GPU: {:?}", adapter.get_info());
+    let (device, queue) = pollster::block_on(adapter.request_device(&Default::default())).unwrap();
+    let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);
+    let vf = wgpu::ShaderStages::VERTEX_FRAGMENT;
+    let entries: Vec<_> = (0..12)
+        .map(|binding| wgpu::BindGroupLayoutEntry {
+            binding,
+            visibility: vf,
+            count: None,
+            ty: match binding {
+                0 => wgpu::BindingType::Buffer {
+                    ty: wgpu::BufferBindingType::Uniform,
+                    has_dynamic_offset: false,
+                    min_binding_size: None,
+                },
+                2 | 4 => wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                b => wgpu::BindingType::Texture {
+                    sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                    view_dimension: if b == 3 {
+                        wgpu::TextureViewDimension::D2
+                    } else {
+                        wgpu::TextureViewDimension::D2Array
+                    },
+                    multisampled: false,
+                },
+            },
+        })
+        .collect();
+    let globals_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: None,
+        entries: &entries,
+    });
+    let shape = TerrainShape {
+        globals: &globals_layout,
+        flat: None,
+        sprites: [1.0, 2048.0],
+        format: wgpu::TextureFormat::Rgba8Unorm,
+    };
+    let shadow = NativeShadow::new(&device, &shape);
+    let data = Uniform {
+        matrix: Mat4::IDENTITY.to_cols_array_2d(),
+        parameters: [1.0 / SIZE as f32, 32.0, 44.0, 1.0],
+    };
+    queue.write_buffer(&shadow.uniform, 0, bytemuck::bytes_of(&data));
+    let texture = device.create_texture(&wgpu::TextureDescriptor {
+        label: None,
+        size: wgpu::Extent3d {
+            width: 2,
+            height: 1,
+            depth_or_array_layers: 1,
+        },
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: wgpu::TextureFormat::Rgba8Unorm,
+        usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+        view_formats: &[],
+    });
+    queue.write_texture(
+        texture.as_image_copy(),
+        &[255, 255, 255, 255, 255, 255, 255, 0],
+        wgpu::TexelCopyBufferLayout {
+            offset: 0,
+            bytes_per_row: Some(8),
+            rows_per_image: None,
+        },
+        texture.size(),
+    );
