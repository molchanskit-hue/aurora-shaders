+mod tests {
+    use super::*;
+    #[test]
+    fn legacy_hdr_fragments_keep_valid_interfaces() {
+        for source in [
+            include_str!("../terrain.wgsl").to_owned(),
+            super::super::entity_shader(),
+            include_str!("../border.wgsl").to_owned(),
+            include_str!("stars.wgsl").to_owned(),
+        ] {
+            let converted = linear_source(&source).unwrap();
+            let module = naga::front::wgsl::parse_str(&converted)
+                .unwrap_or_else(|e| panic!("{}", e.emit_to_string(&converted)));
+            naga::valid::Validator::new(
+                naga::valid::ValidationFlags::all(),
+                naga::valid::Capabilities::all(),
+            )
+            .validate(&module)
+            .unwrap_or_else(|e| panic!("{}", e.emit_to_string(&converted)));
+            let original = naga::front::wgsl::parse_str(&source).unwrap();
+            assert_eq!(module.entry_points.len(), original.entry_points.len());
+            for old in original
+                .entry_points
+                .iter()
+                .filter(|e| e.stage == naga::ShaderStage::Fragment)
+            {
+                assert!(module.entry_points.iter().any(|e| e.name == old.name
+                    && e.function.arguments.len() == old.function.arguments.len()));
+            }
+        }
+    }
+}
diff --git a/crates/horizon-client-render/src/gfx/native_hdr_gpu.rs b/crates/horizon-client-render/src/gfx/native_hdr_gpu.rs
new file mode 100644
