--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/native_hdr_gpu.rs
@@ -0,0 +1,193 @@
+//! Runs inside native_scene to inspect the real pre-translucent snapshot.
+use super::super::{native_hdr, native_post::NativePost, world_post};
+use super::*;
+use horizon_shader_api::{MANIFEST, Pack, check};
+
+#[test]
+fn hdr_blend_snapshot_post_and_format_switch_on_gpu() {
+    let instance = wgpu::Instance::new(wgpu::InstanceDescriptor::new_without_display_handle());
+    let Ok(adapter) = pollster::block_on(instance.request_adapter(&Default::default())) else {
+        assert!(
+            std::env::var_os("AURORA_REQUIRE_GPU").is_none(),
+            "Metal adapter required for HDR readback"
+        );
+        eprintln!("SKIP HDR readback: no GPU adapter");
+        return;
+    };
+    eprintln!("HDR readback GPU: {:?}", adapter.get_info());
+    let (device, queue) = pollster::block_on(adapter.request_device(&Default::default())).unwrap();
+    let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);
+    let sdr = wgpu::TextureFormat::Rgba8Unorm;
+    let mut world = world_post::Post::new(&device, sdr);
+    let frame = NativeFrame::new(&device);
+    let manifest = "schema=1\nid=\"hdr_readback\"\nname=\"HDR readback\"\nversion=\"1\"\napi=\"0.1\"\n[[post]]\nfile=\"p.wgsl\"\n[[post]]\nfile=\"q.wgsl\"\n";
+    let shader = "fn post(i:PostInput)->vec4<f32>{return vec4(i.color.rgb*0.5,1.0);}";
+    let report = check(
+        &Pack::from_files(
+            [(MANIFEST, manifest), ("p.wgsl", shader), ("q.wgsl", shader)]
+                .map(|(n, s)| (n.into(), s.as_bytes().to_vec()))
+                .into(),
+        )
+        .unwrap(),
+    )
+    .unwrap();
+    let mut post = NativePost::new(&device, report.stages, &[], sdr, &frame).unwrap();
+    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+        label: Some("HDR linear blend probe"),
+        source: wgpu::ShaderSource::Wgsl("@vertex fn vs(@builtin(vertex_index)i:u32)->@builtin(position)vec4<f32>{let p=vec2<f32>(f32((i<<1u)&2u),f32(i&2u));return vec4(p*2.0-1.0,0.0,1.0);}\n@fragment fn fs()->@location(0)vec4<f32>{return vec4(2.0,0.75,0.0,0.5);}".into()),
+    });
+    // Same size on the first switch catches a format-only cache miss;
+    // the last switch also exercises resize and rebind of the snapshot/post.
+    for (hdr, size, want) in [
+        (true, [5, 3], [191, 32, 16]),
+        (false, [5, 3], [64, 32, 16]),
+        (true, [7, 5], [191, 32, 16]),
+    ] {
+        let format = if hdr { native_hdr::FORMAT } else { sdr };
+        post.world_format = format;
+        let (color, depth) = world.prepare(&device, size, true, hdr).unwrap();
+        let mut snapshot = NativeScene::new(&device, format);
+        snapshot.prepare(&device, &frame, (&color, &depth), size, None);
+        let pipeline = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some("HDR blend"),
+            layout: None,
+            vertex: wgpu::VertexState {
+                module: &module,
+                entry_point: Some("vs"),
+                compilation_options: Default::default(),
+                buffers: &[],
+            },
+            primitive: Default::default(),
+            depth_stencil: None,
+            multisample: Default::default(),
+            fragment: Some(wgpu::FragmentState {
+                module: &module,
+                entry_point: Some("fs"),
+                compilation_options: Default::default(),
+                targets: &[Some(wgpu::ColorTargetState {
+                    format,
+                    blend: Some(wgpu::BlendState::ALPHA_BLENDING),
+                    write_mask: wgpu::ColorWrites::ALL,
+                })],
+            }),
+            multiview_mask: None,
+            cache: None,
+        });
+        let mut encoder = device.create_command_encoder(&Default::default());
+        {
+            let _clear = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &color,
+                    resolve_target: None,
+                    depth_slice: None,
+                    ops: wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(wgpu::Color {
+                            r: 4.0,
+                            g: 0.25,
+                            b: 0.5,
+                            a: 1.0,
+                        }),
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                    view: &depth,
+                    depth_ops: Some(wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(0.25),
+                        store: wgpu::StoreOp::Store,
+                    }),
+                    stencil_ops: None,
+                }),
+                ..Default::default()
+            });
+        }
+        {
+            let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &color,
+                    resolve_target: None,
+                    depth_slice: None,
+                    ops: wgpu::Operations {
+                        load: wgpu::LoadOp::Load,
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                ..Default::default()
+            });
+            pass.set_pipeline(&pipeline);
+            pass.draw(0..3, 0..1);
+        }
+        snapshot.capture(&mut encoder);
+        // Overwrite the source: the post below must still see the captured HDR blend.
+        {
+            let _clear = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &color,
+                    resolve_target: None,
+                    depth_slice: None,
+                    ops: wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                ..Default::default()
+            });
+        }
+        let output = device.create_texture(&wgpu::TextureDescriptor {
+            label: None,
+            size: wgpu::Extent3d {
+                width: size[0],
+                height: size[1],
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: sdr,
+            usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+            view_formats: &[],
+        });
+        let targets = snapshot.targets.as_ref().unwrap();
+        post.run(
+            &device,
+            &mut encoder,
+            (&targets.color, &targets.depth),
+            &output.create_view(&Default::default()),
+            size,
+            None,
+        );
+        let read = device.create_buffer(&wgpu::BufferDescriptor {
+            label: None,
+            size: u64::from(256 * size[1]),
+            usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            mapped_at_creation: false,
+        });
+        encoder.copy_texture_to_buffer(
+            output.as_image_copy(),
+            wgpu::TexelCopyBufferInfo {
+                buffer: &read,
+                layout: wgpu::TexelCopyBufferLayout {
+                    offset: 0,
+                    bytes_per_row: Some(256),
+                    rows_per_image: Some(size[1]),
+                },
+            },
+            output.size(),
+        );
+        queue.submit([encoder.finish()]);
+        read.slice(..)
+            .map_async(wgpu::MapMode::Read, |r| r.unwrap());
+        device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+        let bytes = read.slice(..).get_mapped_range().unwrap();
+        for y in 0..size[1] as usize {
+            for x in 0..size[0] as usize {
+                let pixel = &bytes[y * 256 + x * 4..y * 256 + x * 4 + 3];
+                assert!(
+                    pixel.iter().zip(want).all(|(a, b)| a.abs_diff(b) <= 1),
+                    "HDR={hdr}, size={size:?}: {pixel:?} != {want:?}"
+                );
+            }
+        }
+    }
+    assert!(pollster::block_on(scope.pop()).is_none());
+}
