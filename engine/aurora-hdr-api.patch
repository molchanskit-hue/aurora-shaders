index 0000000..f362d41
--- /dev/null
+++ b/crates/horizon-shader-api/tests/scene_hdr.rs
@@ -0,0 +1,57 @@
+use horizon_shader_api::{MANIFEST, Pack, StageKind, check};
+
+fn pack(api: &str, display: &str) -> Pack {
+    let manifest = format!(
+        "schema=1\nid=\"hdr_probe\"\nname=\"HDR\"\nversion=\"1\"\napi=\"{api}\"\n[sun_shadows]\nquality=\"low\"\n[sky]\nfile=\"s.wgsl\"\n[material]\nfile=\"m.wgsl\"\n[entity]\nfile=\"e.wgsl\"\n[[post]]\nfile=\"p.wgsl\"\n"
+    );
+    let entity =
+        format!("{display}\nfn entity(i:EntityInput)->vec4<f32>{{return vec4(4.0,2.0,1.0,1.0);}}");
+    Pack::from_files([
+        (MANIFEST, manifest.as_str()),
+        ("s.wgsl", "fn sky(i:SkyInput)->vec4<f32>{return i.color;}"),
+        ("m.wgsl", "fn material(i:MaterialInput)->Surface{return Surface(vec4(4.0,2.0,1.0,1.0),false);}"),
+        ("e.wgsl", entity.as_str()),
+        ("p.wgsl", "fn post(i:PostInput)->vec4<f32>{return i.color*0.25;}")
+    ].map(|(n,s)|(n.into(),s.as_bytes().to_vec())).into()).unwrap()
+}
+
+#[test]
+fn hdr_is_explicit_inherits_forest_and_requires_hand_display() {
+    let body = "fn display(c:vec3<f32>)->vec3<f32>{return horizon_linear_to_srgb(c*0.25);}";
+    let report = check(&pack("0.1-aurora-hdr.1", body)).unwrap();
+    assert!(report.scene_hdr);
+    assert!(
+        report
+            .stages
+            .iter()
+            .all(|s| s.scene_hdr && s.forest && s.clean_lighting)
+    );
+    assert!(check(&pack("0.1-aurora-hdr.1", "")).is_err());
+    let old = check(&pack("0.1-aurora-forest.1", "")).unwrap();
+    assert!(!old.scene_hdr);
+    assert!(old.stages.iter().all(|s| !s.scene_hdr));
+    for stage in [
+        StageKind::Sky,
+        StageKind::Material,
+        StageKind::Entity,
+        StageKind::Post,
+    ] {
+        assert!(
+            !stage
+                .prelude_for("0.1-aurora-forest.1")
+                .contains("fn horizon_linear_to_srgb")
+        );
+    }
+}
+
+#[test]
+fn hdr_rejects_missing_linear_world_stages() {
+    let manifest = "schema=1\nid=\"hdr_probe\"\nname=\"HDR\"\nversion=\"1\"\napi=\"0.1-aurora-hdr.1\"\n[[post]]\nfile=\"p.wgsl\"\n";
+    let files = [
+        (MANIFEST, manifest),
+        ("p.wgsl", "fn post(i:PostInput)->vec4<f32>{return i.color;}"),
+    ]
+    .map(|(n, s)| (n.into(), s.as_bytes().to_vec()))
+    .into();
+    assert!(Pack::from_files(files).is_err());
+}
diff --git a/docs/aurora-hdr-api.md b/docs/aurora-hdr-api.md
new file mode 100644
index 0000000..d45b687
--- /dev/null
+++ b/docs/aurora-hdr-api.md
@@ -0,0 +1,51 @@
+# Local Aurora HDR API (`0.1-aurora-hdr.1`)
+
+Experimental extension of forest.1. Requires all four stages: sky, material,
+entity and at least one post. Requires renderer startup with `AURORA_HDR_PIPELINES=1`.
+Without the matching pipeline set, loading fails and keeps the last good pack.
+This is a local fork contract, not an upstream public API or HDR-display mode.
+
+## Colour contract
+
+- Sky, material and world entity outputs: scene-linear radiance, nonnegative RGB;
+  values above 1 are supported. Alpha retains its previous meaning.
+- Frame palette colours, `SkyInput.color`, albedo/tint, lightmap and
+  `EntityInput.vanilla`: authored display sRGB as before. Explicitly convert when
+  using them as radiance with `horizon_srgb_to_linear`.
+- `MaterialInput.fog.rgb`: linear. Its alpha remains the engine fog factor.
+  Engine-owned terrain/entity fog converts the palette before mixing.
+- Pre-translucent colour, world input, intermediate post/history RGB: linear FP16.
+- Final post output: display sRGB for the existing non-sRGB SDR view. The pack
+  owns exposure and tone mapping. No implicit exposure or automatic adaptation.
+- Mandatory entity `display(vec3<f32>) -> vec3<f32>` maps radiance to display
+  sRGB. Engine calls it once for the first-person hand, after glint and fog.
+  Share the same function with final post to keep their exposure consistent.
+
+GUI rendering and screen capture output stay SDR. Hand rendering follows world
+post and therefore does not receive world bloom. Legacy pack APIs keep their
+old pipeline formats and colour contracts.
+
+## Renderer
+
+World target and pre-translucent snapshot use Rgba16Float. Switching API or
+resizing rebuilds targets; new packs own their own post/history resources.
+Legacy world fragments have separate FP16 variants: Naga moves the fragment
+body into a helper and wraps its output in sRGB decoding. Early returns,
+discard and alpha are preserved. Screen/UI pipelines remain unchanged.
+
+GPU occlusion culling is disabled for HDR in this prototype because its render
+pipeline still has an SDR target. Frustum selection remains active. Compare
+performance with the baseline's occlusion culling disabled as well. Native
+TAA remains disabled under shader packs as before; cloud temporal history is
+pack-owned and remains FP16.
+
+## Validation
+
+`tests/scene_hdr.rs` checks opt-in inheritance, required stages/display and
+legacy isolation. `native_hdr::tests` validates transformed engine fragment
+interfaces. `native_scene::hdr_gpu_tests` reads back HDR alpha blending through
+the actual world target, pre-translucent snapshot and two post passes, then
+switches SDR/HDR and resizes. Entity GPU contract includes HDR hand display.
+Set `AURORA_REQUIRE_GPU=1` to make missing adapters fail these GPU tests.
+The developer archive harness compiles the complete pack and its model/hand
+pipelines; an actual game run must also validate all world fallback pipelines.
