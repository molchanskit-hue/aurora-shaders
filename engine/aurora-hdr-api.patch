diff --git a/crates/horizon-shader-api/src/scene_hdr.wgsl b/crates/horizon-shader-api/src/scene_hdr.wgsl
new file mode 100644
index 0000000..d85f923
--- /dev/null
+++ b/crates/horizon-shader-api/src/scene_hdr.wgsl
@@ -0,0 +1,12 @@
+// hdr.1: albedo, vanilla and FrameInputs colour palettes remain display sRGB.
+// MaterialInput.fog.rgb is linear, matching its Surface output for composition.
+// Stage outputs and scene snapshots are linear radiance. Post's final output and
+// the mandatory entity display(colour) function return display sRGB for SDR output.
+fn horizon_srgb_to_linear(c: vec3<f32>) -> vec3<f32> {
+    let p = max(c, vec3(0.0));
+    return select(pow((p + 0.055) / 1.055, vec3(2.4)), p / 12.92, p <= vec3(0.04045));
+}
+fn horizon_linear_to_srgb(c: vec3<f32>) -> vec3<f32> {
+    let p = max(c, vec3(0.0));
+    return select(1.055 * pow(p, vec3(1.0 / 2.4)) - 0.055, p * 12.92, p <= vec3(0.0031308));
+}
