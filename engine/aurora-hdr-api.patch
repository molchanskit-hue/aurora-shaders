+//! Opt-in FP16 scene variants. SDR pipelines and UI stay byte-for-byte separate.
+//! Legacy world fragments are decoded at their output boundary; this preserves
+//! their authored appearance while blending them with linear pack radiance.
+use std::{cell::RefCell, collections::HashMap};
+
+pub const FORMAT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba16Float;
+
+#[derive(Default)]
+pub struct Pipelines {
+    variants: HashMap<wgpu::RenderPipeline, wgpu::RenderPipeline>,
+}
+impl Pipelines {
+    pub fn enabled(&self) -> bool {
+        !self.variants.is_empty()
+    }
+    pub fn get<'a>(&'a self, pipeline: &'a wgpu::RenderPipeline) -> &'a wgpu::RenderPipeline {
+        self.variants
+            .get(pipeline)
+            .expect("registered HDR world pipeline")
+    }
+}
+
+pub struct Builder {
+    enabled: bool,
+    variants: RefCell<HashMap<wgpu::RenderPipeline, wgpu::RenderPipeline>>,
+}
+impl Builder {
+    pub fn new(enabled: bool) -> Self {
+        Self {
+            enabled,
+            variants: RefCell::new(HashMap::new()),
+        }
+    }
+    pub fn module(&self, device: &wgpu::Device, source: &str) -> Option<wgpu::ShaderModule> {
+        self.enabled.then(|| {
+            device.create_shader_module(wgpu::ShaderModuleDescriptor {
+                label: Some("Aurora linear legacy world fragments"),
+                source: wgpu::ShaderSource::Wgsl(
+                    linear_source(source)
+                        .expect("validated legacy colour shader")
+                        .into(),
+                ),
+            })
+        })
+    }
+    pub fn create(
+        &self,
+        device: &wgpu::Device,
+        descriptor: &wgpu::RenderPipelineDescriptor<'_>,
+        linear: Option<&wgpu::ShaderModule>,
+    ) -> wgpu::RenderPipeline {
+        let base = device.create_render_pipeline(descriptor);
+        if let Some(linear) = linear {
+            let mut hdr = descriptor.clone();
+            let fragment = hdr.fragment.as_mut().expect("world colour fragment");
+            fragment.module = linear;
+            let targets: Vec<_> = fragment
+                .targets
+                .iter()
+                .map(|t| {
+                    t.clone().map(|mut t| {
+                        t.format = FORMAT;
+                        t
+                    })
+                })
+                .collect();
+            fragment.targets = &targets;
+            let pipeline = device.create_render_pipeline(&hdr);
+            self.variants.borrow_mut().insert(base.clone(), pipeline);
+        }
+        base
+    }
+    pub fn finish(self) -> Pipelines {
+        Pipelines {
+            variants: self.variants.into_inner(),
+        }
+    }
+}
+
+/// Move each legacy fragment into an ordinary function and wrap its final RGBA.
+/// Naga handles early returns/discard/control flow; no textual return rewriting.
+/// Only the renderer's RGBA colour shaders go through this adapter, never packs.
+fn linear_source(source: &str) -> Result<String, String> {
+    let mut module = naga::front::wgsl::parse_str(source).map_err(|e| e.emit_to_string(source))?;
+    let mut wrappers = String::new();
+    let entries = std::mem::take(&mut module.entry_points);
+    for entry in entries {
+        if entry.stage != naga::ShaderStage::Fragment {
+            module.entry_points.push(entry);
+            continue;
+        }
+        let result = entry
+            .function
+            .result
+            .as_ref()
+            .ok_or("fragment without colour")?;
+        if !matches!(
+            module.types[result.ty].inner,
+            naga::TypeInner::Vector {
+                size: naga::VectorSize::Quad,
+                scalar: naga::Scalar {
+                    kind: naga::ScalarKind::Float,
+                    width: 4
+                }
+            }
+        ) {
+            return Err(format!("{} is not an RGBA fragment", entry.name));
+        }
+        let mut parameters = Vec::new();
+        let mut arguments = Vec::new();
+        for (i, arg) in entry.function.arguments.iter().enumerate() {
+            let ty = &module.types[arg.ty];
+            let name = match (&ty.name, &ty.inner) {
+                (Some(name), _) => name.clone(),
+                (
+                    _,
+                    naga::TypeInner::Scalar(naga::Scalar {
+                        kind: naga::ScalarKind::Bool,
+                        ..
+                    }),
+                ) => "bool".into(),
+                (
+                    _,
+                    naga::TypeInner::Vector {
+                        size: naga::VectorSize::Quad,
+                        scalar:
+                            naga::Scalar {
+                                kind: naga::ScalarKind::Float,
+                                width: 4,
+                            },
+                    },
+                ) => "vec4<f32>".into(),
+                _ => return Err(format!("unsupported colour fragment input: {:?}", ty.inner)),
+            };
+            let binding = match &arg.binding {
+                None => "",
+                Some(naga::Binding::BuiltIn(naga::BuiltIn::FrontFacing)) => {
+                    "@builtin(front_facing) "
+                }
+                Some(naga::Binding::BuiltIn(naga::BuiltIn::Position { .. })) => {
+                    "@builtin(position) "
+                }
+                _ => return Err("unsupported colour fragment binding".into()),
+            };
+            parameters.push(format!("{binding}arg{i}: {name}"));
+            arguments.push(format!("arg{i}"));
+        }
+        let helper = format!("aurora_legacy_{}", entry.name);
+        wrappers += &format!(
+            "\n@fragment fn {}({}) -> @location(0) vec4<f32> {{ return aurora_decode_legacy({}({})); }}\n",
+            entry.name,
+            parameters.join(", "),
+            helper,
+            arguments.join(", ")
+        );
+        let mut function = entry.function;
+        function.name = Some(helper);
+        for arg in &mut function.arguments {
+            arg.binding = None;
+        }
+        function.result.as_mut().unwrap().binding = None;
+        module.functions.append(function, naga::Span::UNDEFINED);
+    }
+    let info = naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::all(),
+    )
+    .validate(&module)
+    .map_err(|e| e.to_string())?;
+    let mut text = naga::back::wgsl::write_string(
+        &module,
+        &info,
+        naga::back::wgsl::WriterFlags::EXPLICIT_TYPES,
+    )
+    .map_err(|e| e.to_string())?;
+    text += "\nfn aurora_decode_legacy(c: vec4<f32>) -> vec4<f32> { let p = max(c.rgb, vec3(0.0)); return vec4(select(pow((p + 0.055) / 1.055, vec3(2.4)), p / 12.92, p <= vec3(0.04045)), c.a); }\n";
+    text += &wrappers;
+    Ok(text)
+}
