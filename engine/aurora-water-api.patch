@@ -28,6 +28,7 @@ struct HorizonMaterialOut {
     @location(5) position: vec3<f32>,
     @location(6) spherical: f32,
     @location(7) cylindrical: f32,
+    @location(8) @interpolate(flat) is_water: u32,
 }
 fn horizon_material_vertex(position: vec3<f32>, uv: vec2<f32>, layer: u32, color: vec4<f32>,
     light: vec2<u32>, origin: vec3<f32>) -> HorizonMaterialOut {
@@ -37,6 +38,8 @@ fn horizon_material_vertex(position: vec3<f32>, uv: vec2<f32>, layer: u32, color
     out.uv = uv;
     out.layer = layer;
     out.tint = vec4(color.rgb, 1.0);
+    // mesher::NOT_WATER_BIT: clear only for semantic fluid water, not glass.
+    out.is_water = select(0u, 1u, (u32(round(color.a * 255.0)) & 128u) == 0u);
     let block = max(f32(light.y), horizon_terrain_dynamic_block_light(pos));
     let sky = f32(light.x);
     // 16 per level, 15 levels.
@@ -66,7 +69,7 @@ fn horizon_material_vertex(position: vec3<f32>, uv: vec2<f32>, layer: u32, color
 fn horizon_material_color(in: HorizonMaterialOut, translucent: bool) -> vec4<f32> {
     let albedo = horizon_terrain_sprite(in.uv, in.layer & 0x7fffu);
     return material(MaterialInput(albedo, in.tint, in.light, in.lightmap, in.position, in.uv,
-        translucent)).color;
+        translucent, translucent && in.is_water != 0u)).color;
 }
 @fragment fn horizon_material_fs_solid(in: HorizonMaterialOut) -> @location(0) vec4<f32> {
     let color = horizon_material_color(in, false);
@@ -297,7 +300,9 @@ mod tests {
             fn apply_fog(c: vec4<f32>) -> vec4<f32> { return c * gain; }\n\
             fn material(input: MaterialInput) -> Surface {\n    \
                 let lit = input.albedo * input.tint * vec4(input.lightmap, 1.0);\n    \
-                return Surface(apply_fog(sprite(lit)));\n}\n";
+                let normal = cross(dpdx(input.position), dpdy(input.position));\n    \
+                let water = select(0.0, abs(normal.y), input.is_water);\n    \
+                return Surface(apply_fog(sprite(lit)) + vec4(water * 0.01));\n}\n";
         let stage = stage(own);
         let module = module(&stage).unwrap();
         let info = naga::valid::Validator::new(
diff --git a/crates/horizon-client-render/src/mesher.rs b/crates/horizon-client-render/src/mesher.rs
index 8328468..1abcd66 100644
--- a/crates/horizon-client-render/src/mesher.rs
+++ b/crates/horizon-client-render/src/mesher.rs
@@ -32,7 +32,7 @@ pub struct Vertex {
     pub pos: [f32; 3],
     pub uv: [f32; 2],
     pub layer: u32,
-    /// RGBA8: tint multiplied by directional shade and ambient occlusion.
+    /// RGB8 tint * shade * AO; alpha carries emission and `NOT_WATER_BIT`.
     pub color: u32,
     /// Smooth light, 16x fixed point: sky in bits 0..8, block in bits 8..16.
     pub light: u32,
@@ -131,6 +131,22 @@ mod vertex_tests {
         );
     }
     #[test]
+    fn water_tag_preserves_rgb_hdr_and_vertex_layout() {
+        assert_eq!(std::mem::size_of::<TerrainVertex>(), 24);
+        let rgb = super::pack_rgb([0x12, 0x34, 0x56]);
+        for tier in 0..=super::VERY_BRIGHT {
+            let plain = super::emitting(rgb, tier);
+            let water = plain & !super::NOT_WATER_BIT;
+            assert_eq!(plain & 0x00FF_FFFF, water & 0x00FF_FFFF);
+            // terrain.wgsl decodes HDR from only the low alpha nibble.
+            assert_eq!(15 - ((water >> 24) & 15), u32::from(tier));
+            // Simulate the Unorm8 vertex fetch and native WGSL flag decode.
+            let alpha = ((water >> 24) as f32) / 255.0;
+            assert_eq!((alpha * 255.0).round() as u32 & 128, 0);
+            assert_ne!(plain & super::NOT_WATER_BIT, 0);
+        }
+    }
+    #[test]
     fn light_sources_shine_by_kind_not_light_level() {
         use super::{BRIGHT, INCANDESCENT, LOW, hdr_tier};
         assert_eq!(hdr_tier("glowstone", 15), BRIGHT);
@@ -675,8 +691,12 @@ impl Padded {
 pub const OPAQUE_LAYER: u16 = 1 << 15;
 /// The bits of `TerrainVertex::color`'s alpha byte that hold how brightly its face shines
 /// in HDR output (`gfx/hdr.rs`): 15 minus the tier, so the usual 0xFF means none. The
-/// byte's other four bits stay set.
+/// bit 7 marks non-water and the other three bits stay set.
 pub const EMISSION_BITS: u32 = 0x0F00_0000;
+/// Cleared only on fluid water vertices. This unused alpha bit preserves the
+/// 24-byte vertex and the low-nibble HDR tier; shaders never use vertex alpha
+/// as opacity. Native material packs receive it as `MaterialInput.is_water`.
+pub const NOT_WATER_BIT: u32 = 0x8000_0000;
 /// HDR tiers, by the kind of light rather than its level: a candle's flame is as bright as
 /// a torch's, it only lights less around it. 0 stays as in SDR.
 pub const LOW: u8 = 1;
