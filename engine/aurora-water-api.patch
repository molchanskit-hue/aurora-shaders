diff --git a/crates/horizon-shader-api/tests/schema.rs b/crates/horizon-shader-api/tests/schema.rs
index 2176805..0d83639 100644
--- a/crates/horizon-shader-api/tests/schema.rs
+++ b/crates/horizon-shader-api/tests/schema.rs
@@ -13,6 +13,13 @@ fn sample_text() -> String {
     std::fs::read_to_string(sample_dir().join(MANIFEST)).unwrap()
 }
 
+#[test]
+fn local_water_api_is_explicit_and_unknown_extensions_are_rejected() {
+    let local = sample_text().replace("api = \"0.1\"", "api = \"0.1-aurora-water.1\"");
+    assert_eq!(Manifest::parse(&local).unwrap().api, "0.1-aurora-water.1");
+    assert!(Manifest::parse(&local.replace("water.1", "water.2")).is_err());
+}
+
 fn refused(text: &str) -> String {
     Manifest::parse(text).expect_err("should be refused")
 }
