+/// Visual-only Aurora coverage, independent of simulation and breathing. A small
+/// camera volume is intersected with fluid cells; adjacent cells tile without seams.
+pub fn water_immersion(world: &World, facts: &BlockFacts, camera: [f64; 3]) -> f32 {
+    water_coverage(camera, |b| match camera_fluid_height(world, facts, b) {
+        Some((Fluid::Water, h)) => Some(h),
+        _ => None,
+    })
+}
+
+fn water_coverage(camera: [f64; 3], height: impl Fn([i32; 3]) -> Option<f64>) -> f32 {
+    const HALF: f64 = 0.18;
+    let lo = camera.map(|v| v - HALF);
+    let hi = camera.map(|v| v + HALF);
+    let mut volume = 0.0;
+    for y in lo[1].floor() as i32..=hi[1].floor() as i32 {
+        for z in lo[2].floor() as i32..=hi[2].floor() as i32 {
+            for x in lo[0].floor() as i32..=hi[0].floor() as i32 {
+                let Some(h) = height([x, y, z]) else { continue };
+                let b = [x as f64, y as f64, z as f64];
+                let upper = [b[0] + 1.0, b[1] + h.clamp(0.0, 1.0), b[2] + 1.0];
+                volume += (0..3)
+                    .map(|i| (hi[i].min(upper[i]) - lo[i].max(b[i])).max(0.0))
+                    .product::<f64>();
+            }
+        }
+    }
+    let t = (volume / (2.0 * HALF).powi(3)).clamp(0.0, 1.0) as f32;
+    t * t * (3.0 - 2.0 * t)
+}
+
