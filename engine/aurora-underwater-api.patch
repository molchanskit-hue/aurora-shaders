     use super::*;
+    #[test]
+    fn immersion_crosses_surface_continuously_without_internal_cell_seams() {
+        let lake = |b: [i32; 3]| {
+            if b[1] < 0 {
+                Some(1.0)
+            } else if b[1] == 0 {
+                Some(8.0 / 9.0)
+            } else {
+                None
+            }
+        };
+        let surface = 8.0 / 9.0;
+        assert!(water_coverage([0.0, surface + 0.181, 0.0], lake) < 1e-6);
+        assert!((water_coverage([0.0, surface, 0.0], lake) - 0.5).abs() < 1e-5);
+        assert!(water_coverage([0.0, surface - 0.181, 0.0], lake) > 0.99999);
+        let mut previous = 0.0;
+        for n in 0..=100 {
+            let coverage = water_coverage([-2.0, surface + 0.18 - n as f64 * 0.0036, -1.0], lake);
+            assert!(coverage >= previous && coverage - previous < 0.016);
+            previous = coverage;
+        }
+        for x in [
+            -1.00001, -1.0, -0.99999, -0.00001, 0.0, 0.00001, 0.99999, 1.0,
+        ] {
+            for y in [-1.00001, -1.0, -0.99999, 0.0, 0.5] {
+                assert!(
+                    water_coverage([x, y, x], lake) > 0.99999,
+                    "seam at {x}, {y}"
+                );
+            }
+        }
+    }
+
