+#[test]
+fn immersion_frame_appends_one_aligned_vector_without_changing_legacy_fields() {
+    for kind in StageKind::ALL {
+        let prelude = kind.prelude_for("0.1-aurora-water.3");
+        let module = validate(&prelude);
+        let (_, ty) = module
+            .types
+            .iter()
+            .find(|(_, t)| t.name.as_deref() == Some("Frame"))
+            .unwrap();
+        let naga::TypeInner::Struct { members, span } = &ty.inner else {
+            panic!("Frame struct")
+        };
+        assert_eq!(*span as usize, size_of::<Frame>() + 16);
+        let water = members.last().unwrap();
+        assert_eq!(water.name.as_deref(), Some("water"));
+        assert_eq!(water.offset as usize, size_of::<Frame>());
+        for (member, offset) in members.iter().zip(Frame::OFFSETS) {
+            assert_eq!(member.offset as usize, *offset);
+        }
+        for api in ["0.1", "0.1-aurora-water.1", "0.1-aurora-water.2"] {
+            assert!(!kind.prelude_for(api).contains("water: vec4<f32>"));
+        }
+    }
+}
