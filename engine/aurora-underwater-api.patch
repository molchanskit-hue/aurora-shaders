+        let material = "fn material(i: MaterialInput) -> Surface { return Surface(vec4(frame.water.x), false); }";
+        let post = "fn post(i: PostInput) -> vec4<f32> { return mix(i.color, vec4(0.0), frame.water.x * frame.water.y); }";
+        let files = [
+            (MANIFEST, manifest.as_str()),
+            ("m.wgsl", material),
+            ("p.wgsl", post),
+        ]
+        .map(|(k, v)| (k.into(), v.as_bytes().to_vec()))
+        .into();
+        let result = check(&Pack::from_files(files).unwrap());
+        if api.ends_with("water.3") {
+            let result = result.unwrap();
+            assert!(result.water_environment);
+            assert!(result.stages.iter().any(|s| s.scene_snapshot));
+        } else {
+            assert!(result.is_err());
+        }
+    }
+}
