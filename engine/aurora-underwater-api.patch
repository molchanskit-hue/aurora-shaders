+        assert!(water_coverage([-0.5, 5.1, 0.5], thin) > 0.6);
+        assert!(water_coverage([-0.5, 5.1, 0.5], thin) < 1.0);
+        assert_eq!(water_coverage([0.2, 5.1, 0.5], thin), 0.0);
+        assert!(water_coverage([0.0, 5.1, 0.5], thin) > 0.0);
+        assert_eq!(water_coverage([0.0; 3], |_| None), 0.0);
+    }
