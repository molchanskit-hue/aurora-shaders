@@ -0,0 +1,27 @@
+use horizon_shader_api::{MANIFEST, Pack, StageKind, check};
+#[test]
+fn forest_resources_are_material_only_and_old_api_stays_unchanged() {
+    let prelude = StageKind::Material.prelude_for("0.1-aurora-forest.1");
+    assert!(prelude.contains("is_leaves: bool"));
+    assert!(prelude.contains("@binding(4) var contact_depth"));
+    assert!(
+        !StageKind::Material
+            .prelude_for("0.1-aurora-lighting.2")
+            .contains("contact_depth")
+    );
+    for stage in [StageKind::Sky, StageKind::Entity, StageKind::Post] {
+        assert!(
+            !stage
+                .prelude_for("0.1-aurora-forest.1")
+                .contains("contact_depth")
+        );
+    }
+    let manifest = "schema=1\nid=\"forest_probe\"\nname=\"Forest probe\"\nversion=\"1\"\napi=\"0.1-aurora-forest.1\"\n[sun_shadows]\nquality=\"low\"\n[material]\nfile=\"m.wgsl\"\n[entity]\nfile=\"e.wgsl\"\n[[post]]\nfile=\"p.wgsl\"\n";
+    let files=[(MANIFEST,manifest),("m.wgsl","fn material(i:MaterialInput)->Surface {return Surface(vec4(select(i.lighting.rgb,vec3(contact_depth_at(i.screen_uv)),i.is_leaves),i.albedo.a),false);}"),
+        ("e.wgsl","fn entity(i:EntityInput)->vec4<f32>{return i.vanilla;}"),
+        ("p.wgsl","fn post(i:PostInput)->vec4<f32>{return i.color;}")]
+        .map(|(k,v)|(k.into(),v.as_bytes().to_vec())).into();
+    let report = check(&Pack::from_files(files).unwrap()).unwrap();
+    assert_eq!(report.stages.len(), 3);
+    assert!(report.stages.iter().all(|s| s.forest));
+}
