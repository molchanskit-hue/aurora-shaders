new file mode 100644
index 0000000..921e019
--- /dev/null
+++ b/crates/horizon-shader-api/src/contact_depth.wgsl
@@ -0,0 +1,7 @@
+// forest.1 material only: current frame opaque/cutout terrain, before shading.
+// Excludes water, entities, sky, hand and HUD. Reversed depth, 0 = sky.
+@group(3) @binding(4) var contact_depth: texture_depth_2d;
+fn contact_depth_at(uv: vec2<f32>) -> f32 {
+    let size = vec2<f32>(textureDimensions(contact_depth));
+    return textureLoad(contact_depth, vec2<i32>(clamp(uv * size, vec2(0.0), size - 1.0)), 0);
+}
