diff --git a/crates/horizon-client-render/src/gfx/native_contact.rs b/crates/horizon-client-render/src/gfx/native_contact.rs
new file mode 100644
index 0000000..94f42f8
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/native_contact.rs
@@ -0,0 +1,157 @@
+//! forest.1: same-frame opaque terrain depth for material-local ambient occlusion.
+//! No history, colour, entities or water. Allocated only for the opt-in forest API.
+use super::native_material::{TerrainShape, vanilla_terrain};
+
+const ENTRIES: &str = "
+struct ContactVertex {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+    @location(1) @interpolate(flat) layer: u32,
+}
+@vertex fn vs_contact(@location(0) position: vec3<f32>, @location(1) uv: vec2<u32>,
+    @location(2) layer: u32, @location(5) origin: vec4<f32>) -> ContactVertex {
+    return ContactVertex(horizon_terrain_globals.view_proj * vec4(position + origin.xyz, 1.0),
+        horizon_terrain_terrain_uv(uv, origin.w), layer);
+}
+@fragment fn fs_contact(input: ContactVertex) {
+    let alpha = horizon_terrain_sprite(input.uv, input.layer & 0x7fffu).a;
+    if alpha < 0.5 && (input.layer & 0x8000u) == 0u { discard; }
+}
+";
+
+pub struct NativeContact {
+    pipeline: wgpu::RenderPipeline,
+    pub depth: wgpu::TextureView,
+    size: [u32; 2],
+}
+
+fn depth(device: &wgpu::Device, size: [u32; 2]) -> wgpu::TextureView {
+    device
+        .create_texture(&wgpu::TextureDescriptor {
+            label: Some("Aurora contact depth"),
+            size: wgpu::Extent3d {
+                width: size[0],
+                height: size[1],
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Depth32Float,
+            usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::TEXTURE_BINDING,
+            view_formats: &[],
+        })
+        .create_view(&Default::default())
+}
+
+impl NativeContact {
+    pub fn new(device: &wgpu::Device, shape: &TerrainShape<'_>) -> Self {
+        let source = format!("{}\n{ENTRIES}", vanilla_terrain());
+        let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("Aurora contact depth"),
+            source: wgpu::ShaderSource::Wgsl(source.into()),
+        });
+        let layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("Aurora contact depth"),
+            bind_group_layouts: &[Some(shape.globals)],
+            ..Default::default()
+        });
+        let constants = [
+            ("horizon_terrain_SPRITE_ARRAYS", shape.sprites[0]),
+            ("horizon_terrain_SPRITE_SPLIT", shape.sprites[1]),
+        ];
+        let options = wgpu::PipelineCompilationOptions {
+            constants: &constants,
+            ..Default::default()
+        };
+        let pipeline = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some("Aurora contact terrain prepass"),
+            layout: Some(&layout),
+            vertex: wgpu::VertexState {
+                module: &module,
+                entry_point: Some("vs_contact"),
+                compilation_options: options.clone(),
+                buffers: &[
+                    Some(wgpu::VertexBufferLayout {
+                        array_stride: size_of::<super::TerrainVertex>() as u64,
+                        step_mode: wgpu::VertexStepMode::Vertex,
+                        attributes: &super::TERRAIN_ATTRIBUTES,
+                    }),
+                    Some(wgpu::VertexBufferLayout {
+                        array_stride: 16,
+                        step_mode: wgpu::VertexStepMode::Instance,
+                        attributes: &wgpu::vertex_attr_array![5=>Float32x4],
+                    }),
+                ],
+            },
+            primitive: wgpu::PrimitiveState {
+                cull_mode: Some(wgpu::Face::Back),
+                ..Default::default()
+            },
+            depth_stencil: Some(wgpu::DepthStencilState {
+                format: wgpu::TextureFormat::Depth32Float,
+                depth_write_enabled: Some(true),
+                depth_compare: Some(wgpu::CompareFunction::GreaterEqual),
+                stencil: Default::default(),
+                bias: Default::default(),
+            }),
+            multisample: Default::default(),
+            fragment: Some(wgpu::FragmentState {
+                module: &module,
+                entry_point: Some("fs_contact"),
+                compilation_options: options,
+                targets: &[],
+            }),
+            multiview_mask: None,
+            cache: None,
+        });
+        Self {
+            pipeline,
+            depth: depth(device, [1, 1]),
+            size: [1, 1],
+        }
+    }
+    pub fn prepare(&mut self, device: &wgpu::Device, size: [u32; 2]) {
+        if self.size != size {
+            self.depth = depth(device, size);
+            self.size = size;
+        }
+    }
+    pub fn begin<'a>(&self, encoder: &'a mut wgpu::CommandEncoder) -> wgpu::RenderPass<'a> {
+        let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: Some("Aurora contact terrain depth"),
+            color_attachments: &[],
+            depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                view: &self.depth,
+                depth_ops: Some(wgpu::Operations {
+                    load: wgpu::LoadOp::Clear(0.0),
+                    store: wgpu::StoreOp::Store,
+                }),
+                stencil_ops: None,
+            }),
+            ..Default::default()
+        });
+        pass.set_pipeline(&self.pipeline);
+        pass
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn depth_prepass_composes_with_terrain() {
+        let source = format!("{}\n{ENTRIES}", vanilla_terrain());
+        let module = naga::front::wgsl::parse_str(&source).unwrap();
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::all(),
+        )
+        .validate(&module)
+        .unwrap();
+    }
+}
+
+#[cfg(test)]
+#[path = "native_contact_gpu.rs"]
+mod gpu_tests;
