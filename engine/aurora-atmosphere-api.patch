@@ -434,4 +434,25 @@ mod tests {
             .unwrap_or_else(|e| panic!("{}", e.emit_to_string(&shader_source(&stage))));
         }
     }
+    #[test]
+    #[ignore = "developer harness: set HORIZON_VALIDATE_SHADER_PACK to a local pack"]
+    fn local_pack_composes_with_renderer() {
+        let path = std::env::var("HORIZON_VALIDATE_SHADER_PACK").expect("pack path");
+        let pack = Pack::read(std::path::Path::new(&path)).unwrap();
+        let report = check(&pack).unwrap();
+        let stage = report
+            .stages
+            .into_iter()
+            .find(|s| s.kind == horizon_shader_api::StageKind::Material)
+            .expect("stage");
+        let text = shader_source(&stage);
+        let module = naga::front::wgsl::parse_str(&text)
+            .unwrap_or_else(|e| panic!("{}", e.emit_to_string(&text)));
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::all(),
+        )
+        .validate(&module)
+        .unwrap_or_else(|e| panic!("{}", e.emit_to_string(&text)));
+    }
 }
