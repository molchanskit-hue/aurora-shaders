+#[test]
+fn atmosphere_ownership_and_post_shadow_are_explicit() {
+    let manifest = "schema=1\nid=\"t\"\nname=\"T\"\nversion=\"1\"\napi=\"0.1-aurora-atmosphere.1\"\n[sun_shadows]\nquality=\"high\"\n[atmosphere]\ncustom_celestials=true\ncustom_clouds=true\n[sky]\nfile=\"s.wgsl\"\n[material]\nfile=\"m.wgsl\"\n[[post]]\nfile=\"p.wgsl\"\n";
+    let files = [(MANIFEST, manifest),
+        ("s.wgsl", "fn sky(i: SkyInput) -> vec4<f32> { return i.color * frame.atmosphere.x; }"),
+        ("m.wgsl", "fn material(i: MaterialInput) -> Surface { return Surface(i.albedo,false); }"),
+        ("p.wgsl", "fn post(i: PostInput) -> vec4<f32> { return i.color * sun_volume_visibility(view_position(i.uv, i.depth)); }")]
+        .map(|(k,v)| (k.into(), v.as_bytes().to_vec())).into();
+    let pack = Pack::from_files(files).unwrap();
+    let report = check(&pack).unwrap();
+    assert!(report.atmosphere.custom_celestials && report.atmosphere.custom_clouds);
+    assert!(!report.stages[0].sun_shadow);
+    assert!(report.stages[2].sun_shadow);
+    // Older packs must neither claim these layers nor see the new inputs/functions.
+    let old = manifest.replace("0.1-aurora-atmosphere.1", "0.1-aurora-shadow.2");
+    assert!(horizon_shader_api::manifest::Manifest::parse(&old).is_err());
+    let mut files = pack.files;
+    files.insert(
+        MANIFEST.into(),
+        old.replace(
+            "[atmosphere]\ncustom_celestials=true\ncustom_clouds=true\n",
+            "",
+        )
+        .into_bytes(),
+    );
+    assert!(check(&Pack::from_files(files).unwrap()).is_err());
+    assert!(
+        horizon_shader_api::manifest::Manifest::parse(
+            &manifest.replace("[sky]\nfile=\"s.wgsl\"\n", "")
+        )
+        .is_err()
+    );
+}
