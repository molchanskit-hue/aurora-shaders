+
+#[test]
+fn atmosphere_frame_preserves_water_and_appends_lunar_phase() {
+    for kind in StageKind::ALL {
+        let module = validate(&kind.prelude_for("0.1-aurora-atmosphere.1"));
+        let (_, ty) = module
+            .types
+            .iter()
+            .find(|(_, t)| t.name.as_deref() == Some("Frame"))
+            .unwrap();
+        let naga::TypeInner::Struct { members, span } = &ty.inner else {
+            panic!("Frame struct")
+        };
+        assert_eq!(*span as usize, size_of::<Frame>() + 32);
+        assert_eq!(members[members.len() - 2].name.as_deref(), Some("water"));
+        assert_eq!(
+            members[members.len() - 2].offset as usize,
+            size_of::<Frame>()
+        );
+        assert_eq!(members.last().unwrap().name.as_deref(), Some("atmosphere"));
+        assert_eq!(
+            members.last().unwrap().offset as usize,
+            size_of::<Frame>() + 16
+        );
+        for (member, offset) in members.iter().zip(Frame::OFFSETS) {
+            assert_eq!(member.offset as usize, *offset);
+        }
+    }
+}
