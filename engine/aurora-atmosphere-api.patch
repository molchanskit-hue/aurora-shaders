--- /dev/null
+++ b/crates/horizon-shader-api/src/sun_volume.wgsl
@@ -0,0 +1,15 @@
+// atmosphere.1 post stages: one comparison per volume sample, no surface-normal bias.
+// Camera-relative world position; outside the local map is unoccluded.
+fn sun_volume_visibility(position: vec3<f32>) -> f32 {
+    if sun_shadow.parameters.w < 0.5 { return 1.0; }
+    let clip = sun_shadow.matrix * vec4(position, 1.0);
+    let uv = clip.xy * vec2(0.5, -0.5) + vec2(0.5);
+    if any(uv < vec2(0.01)) || any(uv > vec2(0.99)) || clip.z <= 0.0 || clip.z >= 1.0 {
+        return 1.0;
+    }
+    let visible = textureSampleCompareLevel(sun_shadow_depth, sun_shadow_sampler,
+        uv, clip.z - 0.00012 * horizon_sun_bias_scale);
+    let edge = smoothstep(0.0, 0.08, min(min(uv.x, uv.y), min(1.0-uv.x, 1.0-uv.y)));
+    let range = 1.0 - smoothstep(sun_shadow.parameters.y, sun_shadow.parameters.z, length(position));
+    return mix(1.0, visible, edge * range);
+}
