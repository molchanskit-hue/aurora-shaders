diff --git a/crates/horizon-client-render/src/gfx/native_material.rs b/crates/horizon-client-render/src/gfx/native_material.rs
index 97c1e7b..be1edbc 100644
--- a/crates/horizon-client-render/src/gfx/native_material.rs
